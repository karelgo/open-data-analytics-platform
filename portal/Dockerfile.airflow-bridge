# UWV portal Airflow trigger bridge — FastAPI sidecar in de portal-pod.
# Browser hit /api/airflow/trigger-convert → nginx proxy_pass → deze sidecar →
# Airflow REST API (in-cluster, met airflow-api-bot creds).
#
# Build vanuit repo-root:
#   docker build -f portal/Dockerfile.airflow-bridge \
#                -t odap/portal-airflow-bridge:dev .
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN pip install --no-cache-dir \
    'fastapi==0.115.*' \
    'uvicorn[standard]==0.32.*' \
    'pydantic==2.*'

# Houd dezelfde module-pad zodat de K8s-deployment dezelfde import-string
# kan gebruiken: portal.scripts.airflow_bridge:app
COPY portal/scripts/airflow-bridge.py /app/portal/scripts/airflow_bridge.py
RUN mkdir -p /app/portal \
 && touch /app/portal/__init__.py /app/portal/scripts/__init__.py \
 && chown -R 1000:1000 /app

# Non-root user — portal-pod heeft runAsNonRoot=true op pod-niveau.
USER 1000

EXPOSE 8089

# 0.0.0.0 zodat de kubelet (van buiten het pod-network-namespace) de
# readiness/liveness HTTP-probes on the pod-IP kan doen. Binnen het pod
# wordt 127.0.0.1:8089 gebruikt door nginx. De Service expose-set géén
# port 8089 dus alleen pods with the pod-IP kunnen contact maken; voor
# prod hoort hier een NetworkPolicy bij die odap-platform ingress beperkt.
CMD ["uvicorn", "portal.scripts.airflow_bridge:app", "--host", "0.0.0.0", "--port", "8089"]
