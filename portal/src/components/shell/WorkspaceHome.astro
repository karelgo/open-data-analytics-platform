---
/*
  WorkspaceHome — the v2 homepage body.

  Hero (greeting + KPI stats), Recents, Persona shortcuts, and
  "Explore" categorized service tiles. Designed to drop into any
  page that uses ShellLayout.

  Used by:
    - src/pages/index.astro                   (live /)
    - src/pages/styleguide/portal-v2.astro    (mockup showcase)
*/
import ItemTile from './ItemTile.astro';
import { RECENTS, EXPLORE, HERO_STATS } from '../../data/v2-homepage';

interface Props {
  /** Greeting display name. Empty by default; renderWho() in ShellLayout
   *  vult [data-who-name] uit sessionStorage zodra SSO-identity binnen is. */
  userName?: string;
  /** Persona label shown under the greeting. */
  personaLabel?: string;
}
const {
  userName = '',
  personaLabel = 'Data Engineer',
} = Astro.props;
---

<section class="v2-page">
  <!-- ─── Hero ─── -->
  <header class="v2-hero">
    <div class="v2-hero-text">
      <span class="v2-eyebrow">My workspace</span>
      <h1 class="v2-hero-title">Welcome back<span data-who-prefix>{userName ? ', ' : ''}</span><em data-who-name>{userName}</em></h1>
      <p class="v2-hero-sub" data-persona-sub>
        Persona: <b>{personaLabel}</b>
      </p>
    </div>
    <div class="v2-hero-stats">
      {HERO_STATS.map((s) => (
        <div class="v2-stat">
          <span class:list={['v2-stat-val', s.tone && `v2-stat-val--${s.tone}`]}>{s.value}</span>
          <span class="v2-stat-lbl">{s.label}</span>
        </div>
      ))}
    </div>
  </header>

  <section class="v2-section job-market-intro">
    <span class="v2-eyebrow">One use case across the platform</span>
    <h2><a href="/job-market/">Dutch IT Job Market →</a></h2>
    <p>Daily vacancy observations across Data, Cloud, SAP, AI, Software and Security.
      Explore demand, skills, salary evidence and source quality, then follow the same data through the platform.</p>
    <p><a href="/job-market/">Open the synthetic sample explorer</a> ·
      <a href="/embed/superset/?path=/superset/dashboard/dutch-it-job-market/">Open the platform dashboard</a></p>
  </section>

  <!-- ─── Recents ─── -->
  <!-- SSR rendert sample-recents (uit v2-homepage.ts) als first paint.
       Client-side script hieronder fetcht /api/portal/recents en
       vervangt de inhoud als de backend bereikbaar is. Bij onbereik-
       bare backend (lokale dev, cluster restart) blijft de sample
       staan zodat de page niet leeg oogt. -->
  <section class="v2-section">
    <header class="v2-section-head">
      <h2>Recently opened</h2>
    </header>
    <div class="v2-grid" data-recents-grid>
      {RECENTS.map((r) => (
        <ItemTile
          type={r.type}
          service={r.service}
          title={r.title}
          subtitle={r.subtitle}
          owner={r.owner}
          href={r.href}
          status={r.status}
          starred={r.starred}
          itemKey={r.href}
          starrable={true}
        />
      ))}
    </div>
  </section>

  <!-- ─── Explore ─── -->
  <section class="v2-section">
    <header class="v2-section-head">
      <h2>Explore</h2>
      <a class="v2-section-more" href="/embed/dbt-docs/">Lineage diagram →</a>
    </header>
    <div class="v2-explore">
      {EXPLORE.map((cat) => (
        <article class="v2-cat">
          <header class="v2-cat-head">
            <h3>{cat.title}</h3>
            <span>{cat.sub}</span>
          </header>
          <div class="v2-cat-grid">
            {cat.items.map((item) => (
              <ItemTile
                type={item.type}
                service={item.service}
                title={item.title}
                subtitle={item.subtitle}
                href={item.href}
              />
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ─── Foot ─── -->
  <footer class="v2-foot">
    <span class="mono">Portal v2 · {new Date().toISOString().slice(0, 10)}</span>
    <span class="v2-foot-keys">
      <kbd>⌘K</kbd> search &nbsp;·&nbsp;
      <kbd>esc</kbd> close &nbsp;·&nbsp;
      Hover left rail
    </span>
  </footer>
</section>

<script>
  // Client-side persona binding for the homepage.
  //   1. SSR paints the default persona label in the hero subtitle.
  //   2. After load: read odap-portal-role from sessionStorage (set by
  //      ShellLayout's loadIdentity() from /oauth2/userinfo) and
  //      rewrite the hero subtitle to the real persona.
  //   3. ?persona=<role> in URL overrides for local-dev previews.

  const PERSONA_LABELS: Record<string, string> = {
    // Technical personas
    data_engineer:      'Data Engineer',
    data_steward:       'Data Steward',
    researcher:         'Labour Market Researcher',
    platform_admin:     'Platform Admin',
    // Business personas
    claims_analyst:     'Job Market Analyst',
    fraud_analyst:      'Source Quality Analyst',
    marketing_analyst:  'Skills Analyst',
    finance_analyst:    'Salary Analyst',
    operations_manager: 'Market Operations',
  };

  function applyPersona(role: string): void {
    const label = PERSONA_LABELS[role] ?? role;
    const sub = document.querySelector<HTMLElement>('[data-persona-sub]');
    if (sub) {
      sub.innerHTML = `Persona: <b>${label}</b>`;
    }
  }

  // Resolve: URL query (?persona=…) > sessionStorage > default.
  const params = new URLSearchParams(location.search);
  const urlRole = params.get('persona');
  const storedRole = sessionStorage.getItem('odap-portal-role');
  const role = urlRole ?? storedRole ?? 'data_engineer';
  if (PERSONA_LABELS[role]) applyPersona(role);

  // React to sessionStorage updates from ShellLayout's loadIdentity()
  // (e.g. when /oauth2/userinfo resolves after the page has painted).
  // The 'storage' event only fires cross-tab, so we also poll briefly
  // for the same-tab fetch.
  setTimeout(() => {
    const r = sessionStorage.getItem('odap-portal-role');
    if (r && PERSONA_LABELS[r] && r !== role) applyPersona(r);
  }, 250);

  // ───────────────────────────────────────────────────
  // Recents: fetch live data van /api/portal/recents en
  // vervang de SSR sample-tegels. Bij failure → laat sample staan.
  // ───────────────────────────────────────────────────
  type RecentRow = {
    key: string;
    type: string;
    service: string;
    title: string;
    subtitle: string;
    href: string;
    opened_at?: string;
  };

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({
      '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;',
    }[c]!));
  }

  // Compact relative-time formatting ("net" / "12m" / "3u" / "2d").
  function formatAgo(timestamp: string | undefined): string {
    if (!timestamp) return '';
    // SQLite stores datetime() as "YYYY-MM-DD HH:MM:SS" in UTC. Replace
    // the space with 'T' and append 'Z' for ISO parsing.
    const iso = timestamp.includes('T') ? timestamp : timestamp.replace(' ', 'T') + 'Z';
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return '';
    const sec = Math.max(0, Math.floor((Date.now() - then) / 1000));
    if (sec < 60)    return 'net';
    if (sec < 3600)  return `${Math.floor(sec / 60)}m`;
    if (sec < 86400) return `${Math.floor(sec / 3600)}u`;
    return `${Math.floor(sec / 86400)}d`;
  }

  function renderRecent(item: RecentRow, favoriteKeys: Set<string>): string {
    const titleEsc = escapeHtml(item.title);
    const subEsc   = escapeHtml(item.subtitle || '');
    const ago      = formatAgo(item.opened_at);
    const sub      = ago && subEsc ? `${ago} · ${subEsc}` : (ago || subEsc);
    const starred  = favoriteKeys.has(item.key);
    const keyEsc   = escapeHtml(item.key);
    const typeEsc  = escapeHtml(item.type);
    const svcEsc   = escapeHtml(item.service);
    const hrefEsc  = escapeHtml(item.href);
    const ariaLbl  = starred ? 'Verwijder uit favorieten' : 'Markeer als favoriet';
    return `
      <a class="v2-tile" href="${hrefEsc}" data-type="${typeEsc}" data-item-key="${keyEsc}">
        <span class="v2-tile-brand" aria-hidden="true">
          <img src="/icons/brand/${svcEsc}.svg" alt="" width="24" height="24" loading="lazy" />
        </span>
        <span class="v2-tile-body">
          <span class="v2-tile-row">
            <span class="v2-tile-title">${titleEsc}</span>
            <button type="button" class="v2-tile-star"
                    aria-pressed="${starred ? 'true' : 'false'}"
                    aria-label="${ariaLbl}"
                    data-action="favorite-toggle"
                    data-item-key="${keyEsc}"
                    data-item-type="${typeEsc}"
                    data-item-service="${svcEsc}"
                    data-item-title="${titleEsc}"
                    data-item-subtitle="${subEsc}"
                    data-item-href="${hrefEsc}">★</button>
          </span>
          ${sub ? `<span class="v2-tile-subtitle">${sub}</span>` : ''}
          <span class="v2-tile-meta">
            <span class="v2-type-chip" data-type="${typeEsc}">${typeEsc}</span>
          </span>
        </span>
      </a>`;
  }

  async function fetchJson(url: string): Promise<any | null> {
    try {
      const r = await fetch(url, { credentials: 'include' });
      if (!r.ok) return null;
      return await r.json();
    } catch {
      return null;
    }
  }

  async function loadRecents(): Promise<void> {
    const container = document.querySelector<HTMLElement>('[data-recents-grid]');
    if (!container) return;

    // Parallel fetch — favorites bepalen welke recents een ster krijgen.
    const [recentsRes, favoritesRes] = await Promise.all([
      fetchJson('/api/portal/recents'),
      fetchJson('/api/portal/favorites'),
    ]);

    if (!recentsRes || !Array.isArray(recentsRes.items) || recentsRes.items.length === 0) {
      // Geen backend / lege state → SSR sample blijft staan.
      return;
    }

    const favoriteKeys = new Set<string>(
      Array.isArray(favoritesRes?.items)
        ? favoritesRes.items.map((f: { key: string }) => f.key)
        : []
    );

    container.innerHTML = recentsRes.items
      .map((row: RecentRow) => renderRecent(row, favoriteKeys))
      .join('');
  }

  loadRecents();
</script>

<style>
  .v2-page {
    max-width: var(--content-max-w);
    margin: 0 auto;
    padding: var(--space-5) var(--space-7) var(--space-11);
  }

  /* ─── Hero ─── */
  .v2-hero {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-5);
    align-items: end;
    padding: var(--space-7) 0 var(--space-9);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-7);
  }
  .v2-hero-text { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .v2-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--ink-3);
  }
  .v2-hero-title {
    font-size: 40px;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-display);
    color: var(--ink-1);
    margin: 0;
    line-height: 1.05;
  }
  .v2-hero-title em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-3);
    font-weight: var(--weight-regular);
  }
  .v2-hero-sub {
    color: var(--ink-3);
    font-size: var(--text-meta);
    margin: 0;
  }
  .v2-hero-sub b { color: var(--ink-2); font-weight: var(--weight-medium); }
  .v2-hero-stats {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .v2-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: flex-end;
    padding: 0 var(--space-3);
    border-right: 1px solid var(--line);
  }
  .v2-stat:last-child { border-right: 0; padding-right: 0; }
  .v2-stat-val {
    font-family: var(--font-mono);
    font-feature-settings: 'tnum';
    font-size: 22px;
    color: var(--ink-1);
    font-weight: var(--weight-medium);
    line-height: 1;
  }
  .v2-stat-val--down { color: var(--status-down); }
  .v2-stat-val--warn { color: var(--status-warn); }
  .v2-stat-val--ok   { color: var(--status-ok); }
  .v2-stat-lbl {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--ink-3);
  }

  /* ─── Section ─── */
  .v2-section { margin-bottom: var(--space-9); }
  .v2-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .v2-section-head h2 {
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    color: var(--ink-1);
    letter-spacing: var(--tracking-tight);
    margin: 0;
    border: 0;
    padding: 0;
  }
  .v2-section-sub { color: var(--ink-3); font-weight: var(--weight-regular); }
  .v2-section-more {
    color: var(--accent-info);
    text-decoration: none;
    font-size: var(--text-meta);
  }
  .v2-section-more:hover { text-decoration: underline; }

  .v2-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-3);
  }

  /* ─── Explore (category sub-grids) ─── */
  .v2-explore {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: var(--space-5);
  }
  .v2-cat {
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--tile-radius);
    padding: var(--space-5);
  }
  .v2-cat-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .v2-cat-head h3 {
    margin: 0;
    font-size: var(--text-meta);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--ink-1);
    font-weight: var(--weight-medium);
  }
  .v2-cat-head span { color: var(--ink-3); font-size: var(--text-meta); }
  .v2-cat-grid {
    display: grid;
    gap: var(--space-2);
  }

  /* ─── Foot ─── */
  .v2-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--text-meta);
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .v2-foot-keys kbd {
    background: var(--kbd-bg);
    border: 1px solid var(--kbd-line);
    border-radius: 4px;
    padding: 1px 5px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  /* ─── Responsive ─── */
  @media (max-width: 720px) {
    .v2-page { padding: var(--space-3); }
    .v2-hero { grid-template-columns: 1fr; align-items: start; }
    .v2-hero-title { font-size: 28px; }
    .v2-hero-stats { gap: var(--space-2); }
  }
</style>
