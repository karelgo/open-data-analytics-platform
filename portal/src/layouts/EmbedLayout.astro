---
/*
  EmbedLayout — wraps a single service UI inside the v2 shell.

  Renders ShellLayout (rail + top bar) with `embedMode=true` so shell-main
  becomes a flex column at full viewport height. Inside the slot:
    - an embed sub-bar (breadcrumb · deep-link · open-in-tab · fullscreen)
    - an iframe that fills the remaining height
    - loading + blocked + fallback overlays

  The legacy standalone EmbedLayout (its own <html> + theme script + TLD
  rewrite) has been folded into ShellLayout. We only keep the iframe-src
  TLD rewrite here since ShellLayout's MutationObserver only swaps <a>
  href values, not iframe src attributes.

  Fullscreen mode (Esc / "Volledig" button) hides the rail + top bar +
  sub-bar via [data-fullscreen=true] on <html>, leaving the iframe alone.
*/
import ShellLayout from './ShellLayout.astro';
import type { PlatformComponent } from '../data/components';
import { resolveEmbedSrc, resolveExternalUrl } from '../data/components';

interface Props {
  component: PlatformComponent;
  /** Deep-link path-met-query, e.g. "/dashboard/list/?filters=…". */
  deepLink?: string | null;
}

const { component, deepLink = null } = Astro.props;

// Build-time resolutie. De ShellLayout's runtime TLD-rewrite swap't
// *.odap.local op cloud-hosts to the juiste TLD voor <a>
// links; we doen hetzelfde voor iframe-src in <script> hieronder.
const embedSrc = resolveEmbedSrc(component, deepLink);
const externalUrl = resolveExternalUrl(component, deepLink);
const canEmbed = embedSrc !== null;

// Map service-id to rail section so the right rail-icon lights up.
const SECTION_BY_ID: Record<string,
  'home' | 'workspace' | 'storage' | 'catalog' | 'lineage'
  | 'workflows' | 'compute' | 'observability' | 'dashboarding' | 'ai'
> = {
  // Storage
  minio:        'storage',
  // Catalog
  openmetadata: 'catalog',
  hive:         'catalog',  // still highlights Catalog if someone deep-links there
  // Lineage
  'dbt-docs':   'lineage',
  dbt:          'lineage',
  // Workflows
  airflow:      'workflows',
  nifi:         'workflows',
  kafka:        'workflows',
  // Compute
  spark:        'compute',
  trino:        'compute',
  jupyter:      'compute',
  // Observability
  grafana:      'observability',
  prometheus:   'observability',
  opensearch:   'observability',
  // Dashboarding (BI / consumption-laag)
  powerbi:      'dashboarding',
  superset:     'dashboarding',
  // AI (coding-agents + watcher-runtime)
  multica:      'ai',
  nanitics:     'ai',
  // keycloak / opa → default 'workspace'
};
const activeSection = SECTION_BY_ID[component.id] ?? 'workspace';

// Map a service-id to an item-type for the Recents tile icon-tint.
// Duplicate of WorkspaceHome.astro's typeForComponent — when both stop
// changing, extract to a shared util in src/data/.
function trackTypeFor(id: string): string {
  switch (id) {
    case 'superset':
    case 'powerbi':
    case 'grafana':       return 'dashboard';
    case 'openmetadata':
    case 'hive':
    case 'minio':         return 'table';
    case 'airflow':       return 'dag';
    case 'jupyter':       return 'notebook';
    case 'trino':
    case 'prometheus':
    case 'opa':           return 'query';
    case 'spark':
    case 'kafka':
    case 'nifi':
    case 'dbt':
    case 'dbt-docs':
    case 'multica':       return 'pipeline';
    default:              return 'dashboard';
  }
}

// Compose a recents-tracking payload. The key is opaque to the backend
// but stable per (service, deepLink) pair so repeated visits move the
// same row to the top instead of creating duplicates.
const trackKey = `embed:${component.id}${deepLink ? ':' + deepLink : ''}`;
const trackTitle = deepLink
  ? `${component.name} · ${deepLink.slice(0, 60)}`
  : component.name;
const trackSubtitle = component.short ?? '';
const trackHref = deepLink
  ? `/embed/${component.id}/?path=${encodeURIComponent(deepLink)}`
  : `/embed/${component.id}/`;
---

<ShellLayout
  title={component.name}
  description={`${component.name} · embedded in ODAP Portal`}
  activeSection={activeSection}
  activeSubsection={component.id}
  embedMode={true}
>
  <!-- ─── Embed sub-bar: breadcrumb + actions ─── -->
  <header class="embed-subbar">
    <div class="embed-subbar-left">
      <a class="embed-back" href="/" title="Terug naar portal" aria-label="Terug naar portal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
        <span class="embed-back-label">Portal</span>
      </a>
      <span class="embed-divider" aria-hidden="true">/</span>
      <span class="embed-service">
        <img class="embed-service-icon" src={component.icon} alt="" width="18" height="18" />
        <span class="embed-service-name">{component.name}</span>
      </span>
      {deepLink && (
        <>
          <span class="embed-divider" aria-hidden="true">/</span>
          <span class="embed-deep mono" title={deepLink}>{deepLink}</span>
        </>
      )}
    </div>
    <div class="embed-subbar-right">
      {externalUrl && (
        <a class="embed-btn" id="embed-open-external"
           href={externalUrl}
           target="_blank" rel="noopener noreferrer"
           title="Open in new tab">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 3h7v7M10 14L21 3M21 14v7H3V3h7"/>
          </svg>
          <span>New tab</span>
        </a>
      )}
      {canEmbed && (
        <button class="embed-btn" type="button" id="embed-fullscreen"
                title="Full screen (hide shell)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9V3h6M21 9V3h-6M3 15v6h6M21 15v6h-6"/>
          </svg>
          <span>Full screen</span>
        </button>
      )}
    </div>
  </header>

  {canEmbed ? (
    <div class="embed-frame-wrap">
      <iframe
        id="embed-frame"
        class="embed-frame"
        src={embedSrc}
        title={component.name}
        allow="clipboard-write; fullscreen"
        referrerpolicy="same-origin"
      ></iframe>
      <div id="embed-loading" class="embed-loading" aria-live="polite">
        <span class="embed-loading-spinner" aria-hidden="true"></span>
        <span>{component.name} laden…</span>
      </div>
      <div id="embed-blocked" class="embed-blocked" hidden>
        <div class="embed-fallback-card">
          <h1>De iframe laadt niet</h1>
          <p>
            De browser blokkeert het tonen van <strong>{component.name}</strong>
            binnen de portal. Meestal komt dat door een X-Frame-Options /
            CSP-header of door een SSO-redirect die in iframe-context faalt.
          </p>
          {externalUrl && (
            <a class="embed-btn embed-btn-primary" href={externalUrl}
               target="_blank" rel="noopener noreferrer">
              <span>Open {component.name} in nieuw tabblad</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 3h7v7M10 14L21 3M21 14v7H3V3h7"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  ) : (
    <div class="embed-fallback">
      <div class="embed-fallback-card">
        <h1>{component.name} is niet inline embed-baar</h1>
        <p>{component.purpose}</p>
        <p class="embed-fallback-reason">
          {component.embed?.mode === 'none'
            ? 'Deze service heeft geen iframe-veilige UI (login-redirects of admin-flow).'
            : 'Geen iframe-URL beschikbaar voor deze omgeving.'}
        </p>
        {externalUrl && (
          <a class="embed-btn embed-btn-primary" href={externalUrl}
             target="_blank" rel="noopener noreferrer">
            <span>Open {component.name} in nieuw tabblad</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 3h7v7M10 14L21 3M21 14v7H3V3h7"/>
            </svg>
          </a>
        )}
        <a class="embed-back-link" href="/">← Terug naar portal</a>
      </div>
    </div>
  )}
</ShellLayout>

<script define:vars={{
  recentPayload: {
    key:      trackKey,
    type:     trackTypeFor(component.id),
    service:  component.id,
    title:    trackTitle,
    subtitle: trackSubtitle,
    href:     trackHref,
  },
}}>
  // ─── Recents tracking ───
  // Fire-and-forget POST naar /api/portal/recents zodra de iframe-page
  // laadt. Backend (zie portal-backend.py) dedupliceert op `key` en
  // bumpt opened_at. Failures zijn stil — als de backend down is, gaat
  // de portal gewoon door zonder recents-functionaliteit.
  //
  // keepalive=true zorgt dat de request afgemaakt wordt als de
  // gebruiker direct doorklikt naar een andere embed.
  try {
    fetch('/api/portal/recents', {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(recentPayload),
      keepalive: true,
    }).catch(() => { /* silently fail — geen blocking UX */ });
  } catch {
    /* fetch onbeschikbaar (oude browser) — skip */
  }
</script>

<script>
  // ─── TLD-rewrite voor iframe-src ───
  // ShellLayout's rewrite swap't alleen <a href> waarden. De iframe-src
  // op cloud-hosts (*.example.com, *.example.com)
  // moet ook bijgewerkt — anders probeert de iframe een onbereikbare
  // *.odap.local:8443 host te laden.
  (function () {
    const host = window.location.hostname;
    const CLOUD_TLDS = ['example.com', 'example.com'];
    let targetTld: string | null = null;
    for (const t of CLOUD_TLDS) {
      if (host === t || host.endsWith('.' + t)) { targetTld = t; break; }
    }
    if (!targetTld) return;
    const KEEP_LOCAL = ['multica', 'nanitics'];

    function rewriteHref(href: string): string {
      const m = href.match(/:\/\/([a-z0-9-]+)\.odap-platform\.local(:8443)?/);
      if (m && KEEP_LOCAL.indexOf(m[1]) !== -1) return href;
      return href.replace(
        /:\/\/([a-z0-9-]+)\.odap-platform\.local(:8443)?/g,
        '://$1.' + targetTld,
      );
    }

    const iframe = document.getElementById('embed-frame') as HTMLIFrameElement | null;
    if (iframe && iframe.src) iframe.src = rewriteHref(iframe.src);
  })();

  // ─── Fullscreen toggle ───
  // Sets html[data-fullscreen=true] which hides the rail, topbar v2,
  // and the embed sub-bar via global CSS below. Esc returns to normal.
  const fsBtn = document.getElementById('embed-fullscreen');
  function setFullscreen(on: boolean): void {
    if (on) document.documentElement.dataset.fullscreen = 'true';
    else delete document.documentElement.dataset.fullscreen;
  }
  fsBtn?.addEventListener('click', () => {
    const isOn = document.documentElement.dataset.fullscreen === 'true';
    setFullscreen(!isOn);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.documentElement.dataset.fullscreen === 'true') {
      e.preventDefault();
      setFullscreen(false);
    }
  });

  // ─── Iframe load / failure UX ───
  // Cross-origin iframes geven ons geen access tot contentDocument, maar
  // 'load' vuurt wel zodra de browser response heeft ontvangen.
  //   - load event binnen 8s → spinner weg
  //   - timeout zonder load → toon "blocked"-fallback met
  //     "open in nieuw tabblad"-knop
  const frame = document.getElementById('embed-frame') as HTMLIFrameElement | null;
  const loading = document.getElementById('embed-loading');
  const blocked = document.getElementById('embed-blocked');
  if (frame && loading) {
    let timeoutId: number | undefined = window.setTimeout(() => {
      if (loading) loading.hidden = true;
      if (blocked) blocked.hidden = false;
      if (frame) frame.style.opacity = '0.05';
    }, 8000);
    frame.addEventListener('load', () => {
      if (timeoutId !== undefined) {
        window.clearTimeout(timeoutId);
        timeoutId = undefined;
      }
      if (loading) loading.hidden = true;
    });
  }
</script>

<style is:global>
  /* ─── Embed sub-bar ─── */
  /* Sits inside shell-main directly below the v2 topbar. Same height
     as the legacy embed-topbar (~40px) so existing iframes look right. */
  .embed-subbar {
    background: var(--bg-elev);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px;
    gap: var(--space-3);
    min-height: 40px;
    flex-shrink: 0;
  }
  .embed-subbar-left,
  .embed-subbar-right {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .embed-subbar-left { flex: 1; min-width: 0; }

  .embed-back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink-2);
    text-decoration: none;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    font-size: var(--text-meta);
    line-height: 1;
    transition: background var(--motion-fast), color var(--motion-fast);
  }
  .embed-back:hover {
    background: var(--bg-sunken);
    color: var(--ink-1);
    text-decoration: none;
  }
  .embed-back-label { font-weight: var(--weight-medium); }

  .embed-divider {
    color: var(--ink-4);
    font-size: var(--text-meta);
  }
  .embed-service {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink-1);
    font-size: var(--text-meta);
  }
  .embed-service-icon { display: block; flex-shrink: 0; }
  .embed-service-name { font-weight: var(--weight-medium); }
  .embed-deep {
    color: var(--ink-3);
    font-size: var(--text-micro);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 40ch;
  }

  .embed-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 4px 10px;
    background: var(--bg);
    color: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--text-micro);
    line-height: 1;
    cursor: pointer;
    text-decoration: none;
    font-family: var(--font-sans);
    transition: background var(--motion-fast), color var(--motion-fast), border-color var(--motion-fast);
  }
  .embed-btn:hover {
    background: var(--bg-elev);
    color: var(--ink-1);
    border-color: var(--ink-4);
    text-decoration: none;
  }
  .embed-btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
    font-size: var(--text-meta);
    padding: 8px 14px;
  }
  .embed-btn-primary:hover {
    background: var(--accent);
    color: var(--accent-ink);
    opacity: 0.92;
  }

  /* ─── Iframe wrapper ─── */
  /* Fills the remaining height of shell-main (which is flex-column at
     calc(100vh - topbar-h) in embed mode). Loading + blocked overlays
     are absolute-positioned inside this wrapper. */
  .embed-frame-wrap {
    position: relative;
    flex: 1;
    min-height: 0;
    background: var(--bg-sunken);
  }
  .embed-frame {
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--bg-sunken);
    display: block;
    transition: opacity var(--motion-base);
  }

  /* Spinner overlay during initial iframe-load. */
  .embed-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    color: var(--ink-3);
    font-size: var(--text-meta);
    background: var(--bg);
    pointer-events: none;
    z-index: 5;
  }
  .embed-loading[hidden] { display: none; }
  .embed-loading-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid var(--ink-4);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: embed-spin 0.8s linear infinite;
  }
  @keyframes embed-spin { to { transform: rotate(360deg); } }

  /* Blocked overlay (8s load timeout). */
  .embed-blocked {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-7);
    background: var(--bg);
    z-index: 6;
  }
  .embed-blocked[hidden] { display: none; }

  /* Non-embeddable services (mode='none'). Fills the slot at flex:1. */
  .embed-fallback {
    flex: 1;
    min-height: 0;
    display: grid;
    place-items: center;
    padding: var(--space-7);
    background: var(--bg);
  }
  .embed-fallback-card {
    max-width: 480px;
    text-align: left;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }
  .embed-fallback-card h1 {
    font-size: var(--text-h3);
    margin: 0;
    border: 0;
    padding: 0;
    color: var(--ink-1);
  }
  .embed-fallback-card p { margin: 0; color: var(--ink-2); }
  .embed-fallback-reason {
    font-size: var(--text-meta);
    color: var(--ink-3);
    font-style: italic;
  }
  .embed-back-link {
    color: var(--ink-3);
    font-size: var(--text-meta);
    margin-top: var(--space-2);
    text-decoration: none;
  }
  .embed-back-link:hover { color: var(--ink-1); text-decoration: underline; }

  /* ─── Fullscreen mode ─── */
  /* Toggled by the "Volledig" button. Hides ALL shell chrome (rail,
     v2 topbar, embed sub-bar) so the iframe gets the full viewport.
     Esc inside the page or the button itself toggles back. */
  html[data-fullscreen="true"] .rail,
  html[data-fullscreen="true"] .topbarv2,
  html[data-fullscreen="true"] .embed-subbar {
    display: none !important;
  }
  html[data-fullscreen="true"] body.shell .shell-main {
    margin-left: 0 !important;
    padding-top: 0 !important;
  }

  @media (max-width: 640px) {
    .embed-back-label { display: none; }
    .embed-deep { max-width: 18ch; }
    .embed-btn span { display: none; }
  }
</style>
