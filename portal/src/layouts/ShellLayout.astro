        padding: 0 10px 0 4px;
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
        background: var(--bg-elev);
        color: var(--ink-1);
        font-size: var(--text-meta);
        font-family: var(--font-sans);
      }
      .topbarv2-persona-dot {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        font-size: 10px;
        font-weight: var(--weight-bold);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .topbarv2-user {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--accent);
        color: var(--accent-ink);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: var(--weight-bold);
        font-size: 13px;
        flex-shrink: 0;
        border: 0;
        padding: 0;
        cursor: pointer;
        font-family: var(--font-sans);
        transition: filter var(--motion-fast);
      }
      .topbarv2-user:hover { filter: brightness(1.1); }

      /* User-info header inside the user dropdown */
      .topbarv2-user-info {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px;
      }
      .topbarv2-user-info-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--accent);
        color: var(--accent-ink);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: var(--weight-bold);
        font-size: 16px;
        flex-shrink: 0;
      }
      .topbarv2-user-info-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
      }
      .topbarv2-user-info-text b {
        font-weight: var(--weight-medium);
        color: var(--ink-1);
        font-size: var(--text-meta);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 220px;
      }
      .topbarv2-user-info-text em {
        font-style: normal;
        color: var(--ink-3);
        font-size: 12px;
        font-family: var(--font-mono);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 220px;
      }

      /* ─── Topbar dropdown ─── */
      .topbarv2-dropdown { position: relative; }
      .topbarv2-panel {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 280px;
        background: var(--bg-elev);
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        box-shadow: 0 16px 48px -12px rgba(0, 0, 0, 0.5);
        padding: 6px;
        opacity: 0;
        transform: translateY(-4px);
        pointer-events: none;
        transition: opacity var(--motion-fast), transform var(--motion-fast);
        z-index: 30;
      }
      .topbarv2-panel--wide { min-width: 340px; }
      .topbarv2-panel--right { right: 0; left: auto; }
      .topbarv2-dropdown[data-open] .topbarv2-panel {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }

      .topbarv2-panel-head {
        display: flex;
        justify-content: space-between;
        padding: 8px 12px 4px;
        font-size: var(--text-eyebrow);
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: var(--tracking-eyebrow);
        color: var(--ink-3);
      }
      .topbarv2-panel-head span { color: var(--accent-info); }
      .topbarv2-panel-foot {
        padding: 8px 12px;
        border-top: 1px solid var(--line);
        margin-top: 4px;
        font-size: var(--text-meta);
      }
      .topbarv2-panel-foot a { color: var(--accent-info); }

      .topbarv2-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 10px;
        border-radius: var(--radius-sm);
        color: var(--ink-1);
        text-decoration: none;
        transition: background var(--motion-fast);
      }
      .topbarv2-item:hover {
        background: var(--bg-sunken);
        text-decoration: none;
      }
      .topbarv2-item-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: var(--weight-bold);
        color: white;
        flex-shrink: 0;
      }
      .topbarv2-item-icon[data-color="query"]     { background: var(--type-query); }
      .topbarv2-item-icon[data-color="notebook"]  { background: var(--type-notebook); }
      .topbarv2-item-icon[data-color="dashboard"] { background: var(--type-dashboard); }
      .topbarv2-item-icon[data-color="table"]     { background: var(--type-table); }
      .topbarv2-item-icon[data-color="admin"]     { background: var(--persona-admin); }
      .topbarv2-item-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: var(--text-meta);
      }
      .topbarv2-item-text b  { font-weight: var(--weight-medium); }
      .topbarv2-item-text em { font-style: normal; color: var(--ink-3); font-size: 12px; }
      .topbarv2-sep {
        border: 0;
        border-top: 1px solid var(--line);
        margin: 4px 6px;
      }

      .topbarv2-event {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 8px 10px;
        border-radius: var(--radius-sm);
        color: var(--ink-1);
        text-decoration: none;
        transition: background var(--motion-fast);
      }
      .topbarv2-event:hover {
        background: var(--bg-sunken);
        text-decoration: none;
      }
      .topbarv2-event-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-top: 6px;
        flex-shrink: 0;
      }
      .topbarv2-event-dot[data-tone="down"] { background: var(--status-down); }
      .topbarv2-event-dot[data-tone="ok"]   { background: var(--status-ok); }
      .topbarv2-event-dot[data-tone="info"] { background: var(--accent-info); }
      .topbarv2-event-body { flex: 1; display: flex; flex-direction: column; gap: 2px; font-size: var(--text-meta); }
      .topbarv2-event-body b  { font-weight: var(--weight-medium); }
      .topbarv2-event-body em { font-style: normal; color: var(--ink-3); font-size: 12px; }
      .topbarv2-event-body code { background: var(--bg-sunken); padding: 0 4px; border-radius: 3px; font-size: 11px; }
      .topbarv2-event-time { color: var(--ink-3); font-size: 11px; font-family: var(--font-mono); flex-shrink: 0; }

      .topbarv2-event-empty {
        padding: 16px 12px;
        color: var(--ink-3);
        font-size: var(--text-meta);
        text-align: center;
      }

      /* ─── Command palette ─── */
      .cmdk[hidden] { display: none !important; }
      .cmdk {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 14vh;
        animation: cmdk-fade 120ms ease-out;
      }
      @keyframes cmdk-fade {
        from { opacity: 0; }
        to   { opacity: 1; }
      }
      .cmdk-overlay {
        position: absolute;
        inset: 0;
        background: var(--cmdk-overlay);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
      }
      .cmdk-card {
        position: relative;
        width: min(640px, calc(100vw - 32px));
        max-height: 70vh;
        background: var(--cmdk-bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        box-shadow: 0 24px 80px -24px rgba(0, 0, 0, 0.6);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .cmdk-input-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border-bottom: 1px solid var(--line);
        color: var(--ink-3);
        background: var(--cmdk-input-bg);
      }
      .cmdk-input {
        flex: 1;
        background: transparent;
        border: 0;
        outline: 0;
        color: var(--ink-1);
        font-family: var(--font-sans);
        font-size: var(--text-body-lg);
        padding: 2px 0;
      }
      .cmdk-input::placeholder { color: var(--ink-4); }
      .cmdk-results {
        flex: 1;
        overflow-y: auto;
        padding: 6px;
      }
      .cmdk-empty {
        padding: 24px 16px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        color: var(--ink-3);
        font-size: var(--text-meta);
        text-align: center;
      }
      .cmdk-empty strong { color: var(--ink-1); font-weight: var(--weight-medium); }
      .cmdk-empty code { background: var(--bg-sunken); padding: 0 4px; border-radius: 3px; }
      .cmdk-group { padding: 4px 0; }
      .cmdk-group-head {
        padding: 8px 10px 4px;
        font-size: var(--text-eyebrow);
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: var(--tracking-eyebrow);
        color: var(--ink-3);
      }
      .cmdk-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 10px;
        border-radius: var(--radius-sm);
        color: var(--ink-1);
        text-decoration: none;
        transition: background var(--motion-fast);
      }
      .cmdk-item:hover,
      .cmdk-item[data-cmdk-selected="true"] {
        background: var(--bg-sunken);
        text-decoration: none;
      }
      .cmdk-item-icon {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: var(--weight-bold);
        color: white;
        flex-shrink: 0;
      }
      .cmdk-item-icon[data-color="dashboard"] { background: var(--type-dashboard); }
      .cmdk-item-icon[data-color="dag"]       { background: var(--type-dag); }
      .cmdk-item-icon[data-color="table"]     { background: var(--type-table); }
      .cmdk-item-icon[data-color="notebook"]  { background: var(--type-notebook); }
      .cmdk-item-icon[data-color="query"]     { background: var(--type-query); }
      .cmdk-item-icon[data-color="pipeline"]  { background: var(--type-pipeline); }

      /* Brand-icon variant in command palette — type-tinted square
         holding the service brand SVG. Same colour-mix logic as
         .v2-tile-brand but at 32px footprint. */
      .cmdk-item-brand {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--bg-sunken);
        border: 1px solid var(--line);
      }
      .cmdk-item-brand img { width: 20px; height: 20px; display: block; }
      .cmdk-item[data-type="dashboard"] .cmdk-item-brand {
        background: color-mix(in oklch, var(--type-dashboard) 14%, var(--bg-sunken));
        border-color: color-mix(in oklch, var(--type-dashboard) 30%, var(--line));
      }
      .cmdk-item[data-type="dag"] .cmdk-item-brand {
        background: color-mix(in oklch, var(--type-dag) 14%, var(--bg-sunken));
        border-color: color-mix(in oklch, var(--type-dag) 30%, var(--line));
      }
      .cmdk-item[data-type="table"] .cmdk-item-brand {
        background: color-mix(in oklch, var(--type-table) 14%, var(--bg-sunken));
        border-color: color-mix(in oklch, var(--type-table) 30%, var(--line));
      }
      .cmdk-item[data-type="notebook"] .cmdk-item-brand {
        background: color-mix(in oklch, var(--type-notebook) 14%, var(--bg-sunken));
        border-color: color-mix(in oklch, var(--type-notebook) 30%, var(--line));
      }
      .cmdk-item[data-type="query"] .cmdk-item-brand {
        background: color-mix(in oklch, var(--type-query) 14%, var(--bg-sunken));
        border-color: color-mix(in oklch, var(--type-query) 30%, var(--line));
      }
      .cmdk-item[data-type="pipeline"] .cmdk-item-brand {
        background: color-mix(in oklch, var(--type-pipeline) 14%, var(--bg-sunken));
        border-color: color-mix(in oklch, var(--type-pipeline) 30%, var(--line));
      }
      .cmdk-item-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
      }
      .cmdk-item-title {
        font-size: var(--text-meta);
        font-weight: var(--weight-medium);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .cmdk-item-sub {
        font-size: 12px;
        color: var(--ink-3);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .cmdk-foot {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 10px 14px;
        border-top: 1px solid var(--line);
        background: var(--cmdk-input-bg);
        font-size: 11px;
        color: var(--ink-3);
      }
      .cmdk-foot kbd { padding: 1px 5px; }
      .cmdk-foot-meta {
        margin-left: auto;
        font-family: var(--font-mono);
        color: var(--ink-4);
      }

      /* ─── Footer ─── */
      .shell-footer {
        border-top: 1px solid var(--line);
        margin-top: var(--space-9);
      }
      .shell-footer-inner {
        max-width: var(--content-max-w);
        margin: 0 auto;
        padding: var(--space-5) var(--space-7);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-5);
        color: var(--ink-3);
        font-size: var(--text-meta);
        flex-wrap: wrap;
      }
      .shell-footer-links {
        display: inline-flex;
        gap: var(--space-3);
        align-items: center;
      }
      .shell-footer-inner a {
        color: var(--ink-3);
        text-decoration: none;
      }
      .shell-footer-inner a:hover { color: var(--ink-1); }

      /* ─── Responsive: hide rail on narrow screens ─── */
      @media (max-width: 720px) {
        .rail { transform: translateX(-100%); }
        .shell-main { margin-left: 0 !important; }
        .topbarv2 { left: 0 !important; padding: 0 var(--space-3); }
        .topbarv2-search-placeholder { display: none; }
        .topbarv2-persona-label { display: none; }
        .shell-footer-inner { padding: var(--space-4) var(--space-3); }
      }
    </style>
  </body>
</html>
