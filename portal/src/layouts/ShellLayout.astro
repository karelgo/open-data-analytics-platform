---
/*
  ShellLayout — v2 layout for the Databricks/Fabric-style shell.

  Provides:
    - Left rail (56px, hover-expand to 240px)
    - Top bar (search trigger + Cmd+K + New + bell + persona + theme + user)
    - Command Palette (Cmd+K modal with grouped search results)
    - Dropdown toggle pattern for + New / Notifications / Persona menus

  Coexists with the legacy Layout.astro — only pages that explicitly
  import ShellLayout get the new chrome. Default route stays on Layout.

  All shell CSS uses rail- / topbarv2- / cmdk- prefixes to avoid
  collision with legacy styles. v2-tile lives in ItemTile.astro.

  Preview: /styleguide/portal-v2/
*/
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/tokens-v2.css';
import '../styles/base.css';

import CommandPalette from '../components/shell/CommandPalette';
import NotificationBell from '../components/shell/NotificationBell';

interface Props {
  title: string;
  description?: string;
  /** Which left-rail item is highlighted. */
  activeSection?:
    | 'home' | 'job-market' | 'workspace' | 'storage' | 'catalog' | 'lineage'
    | 'workflows' | 'compute' | 'observability' | 'dashboarding' | 'ai'
    | 'academy' | 'settings';
  /**
   * Optional sub-rail highlight (e.g. 'grafana', 'prometheus', 'opensearch'
   * inside the 'observability' group). Matches a child entry's `id`.
   */
  activeSubsection?: string;
  /** Mock persona for the mockup. Real impl reads from oauth2-proxy. */
  persona?:
    | 'data_engineer' | 'data_analyst' | 'data_steward'
    | 'researcher'    | 'platform_admin';
  /** Mock user-display name. */
  userName?: string;
  /**
   * Embed mode — used by EmbedLayout to wrap an iframe at full height.
   * When true: no footer, shell-main becomes a flex column at calc(100vh
   * - topbar-h), and the slotted content can use flex:1 to fill remaining
   * space below an embed-specific sub-bar.
   */
  embedMode?: boolean;
}

const {
  title,
  description = 'Open Data & Analytics Platform — v2 shell',
  activeSection = 'home',
  activeSubsection,
  persona = 'data_engineer',
  // userName starts empty; loadIdentity() vult de avatar/dropdown vanuit
  // /oauth2/userinfo en renderWho() rendert het via data-who-name selectors.
  userName = '',
  embedMode = false,
} = Astro.props;

// Persona metadata — display label + initials + hue.
const PERSONAS: Record<string, { label: string; initials: string; color: string }> = {
  data_engineer:  { label: 'Data Engineer',  initials: 'DE', color: 'var(--persona-engineer)' },
  data_analyst:   { label: 'Data Analyst',   initials: 'DA', color: 'var(--persona-analyst)' },
  data_steward:   { label: 'Data Steward',   initials: 'DS', color: 'var(--persona-steward)' },
  researcher:     { label: 'Labour Market Researcher',     initials: 'R',  color: 'var(--persona-scientist)' },
  platform_admin: { label: 'Platform Admin', initials: 'PA', color: 'var(--persona-admin)' },
};
const currentPersona = PERSONAS[persona] ?? PERSONAS.data_engineer;

// Inline SVG path-sets per rail-icon, Lucide style. Mounted via set:html.
const RAIL_ICONS: Record<string, string> = {
  home:          '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-5h-2v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  'job-market':  '<rect x="3" y="6" width="18" height="15" rx="2"/><path d="M8 6V3h8v3M3 12h18M10 12v3h4v-3"/>',
  workspace:     '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  catalog:       '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  // Storage = stacked-disk database icon. Echoes MinIO / object-store
  // visual language (bronze / silver / gold zones live here).
  storage:       '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>',
  // Lineage = DAG-style network icon (3 nodes + connectors). Echo's the
  // dbt-docs lineage graph visually.
  lineage:       '<rect x="9" y="2" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="16" y="16" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/>',
  workflows:     '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><path d="M6.5 10v4a2 2 0 0 0 2 2H14"/>',
  compute:       '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/>',
  observability: '<path d="M3 3v18h18"/><path d="M7 14l4-4 4 3 5-6"/>',
  // Dashboarding = 4-quadrant LayoutDashboard (Lucide). Visueel onderscheidend
  // van Observability's lijn-chart — communiceert "tegel-dashboard" zoals
  // Power BI / Superset / Looker dat tonen.
  dashboarding:  '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="3" height="5" x="3" y="16" rx="1"/>',
  // AI = sparkles (Lucide-style). Visueel onmiskenbaar de "AI-icon"
  // die o.a. Copilot, Notion AI en Linear gebruiken voor agents.
  ai:            '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/><path d="M5 3v4"/><path d="M3 5h4"/><path d="M19 17v4"/><path d="M17 19h4"/>',
  academy:       '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 3 3 6 3s6-1 6-3v-5"/>',
  settings:      '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
};

// Left rail sections — one entry per top-level navigation target.
// URLs map onto existing portal routes; embed-routes deep-link into
// service UIs via the /embed/<id>/?path=… shell.
//
// "Lineage + techn. doc." is the compact label for the dbt-docs route;
// the full name lives in `title` so the tooltip shows the long form.
const RAIL_MAIN = [
  { id: 'home',          label: 'Home',                    href: '/' },
  { id: 'job-market', label: 'Dutch IT jobs', href: '/job-market/' },
  { id: 'workspace',     label: 'My workspace',            href: '/me/' },
  // Data-foundation block: where data lives + describing it + how it flows.
  // Storage and Catalog have just one usable service each, so no sub-rail —
  // the parent is the direct link.
  { id: 'storage',       label: 'Storage',                 href: '/embed/minio/' },
  { id: 'catalog',       label: 'Catalog',                 href: '/embed/openmetadata/' },
  { id: 'lineage',       label: 'Lineage + technical docs', href: '/embed/dbt-docs/',
    title: 'dbt-docs · lineage + technical documentation' },
  // Workflows currently only has Airflow as a working embed; NiFi / Kafka
  // don't have iframe-safe UIs in this deployment so they're hidden until
  // they get linkable destinations.
  { id: 'workflows',     label: 'Workflows',               href: '/embed/airflow/' },
  { id: 'compute',       label: 'Compute',                 href: '/embed/jupyter/',
    children: [
      { id: 'jupyter', label: 'Jupyter', href: '/embed/jupyter/' },
      { id: 'spark',   label: 'Spark',   href: '/embed/spark/' },
    ],
  },
  { id: 'observability', label: 'Observability',           href: '/embed/grafana/',
    children: [
      { id: 'grafana',    label: 'Grafana',    href: '/embed/grafana/' },
      { id: 'prometheus', label: 'Prometheus', href: '/embed/prometheus/' },
      { id: 'opensearch', label: 'OpenSearch', href: '/embed/opensearch/' },
    ],
  },
  // Dashboarding block — consumption-laag voor business-rollen. Power BI is
  // de primary landing (Microsoft Fabric tenant SSO via users' eigen
  // Azure-tenant); Superset blijft toegankelijk als legacy/open-source
  // alternatief tot de migratie compleet is. Zie
  // FreshLakehouse/docs/research/powerbi-as-bi-and-self-service-layer.md
  // for the migratie-roadmap.
  { id: 'dashboarding', label: 'Dashboarding',             href: '/embed/superset/',
    children: [
      { id: 'powerbi',  label: 'Power BI',  href: '/embed/powerbi/' },
      { id: 'superset', label: 'Superset',  href: '/embed/superset/' },
    ],
  },
  // AI block — coding-agents en watcher-runtime. Beide hebben een werkende
  // iframe-veilige UI in dit cluster. Multica is de primary landing
  // (coding-agent coordinator); Nanitics is de Observatory voor agent-runs.
  { id: 'ai', label: 'AI', href: '/embed/multica/',
    children: [
      { id: 'multica',  label: 'Multica',  href: '/embed/multica/' },
      { id: 'nanitics', label: 'Nanitics', href: '/embed/nanitics/' },
    ],
  },
] as const;
const RAIL_FOOT = [
  { id: 'academy',  label: 'Academy',       href: '/learn/' },
  { id: 'settings', label: 'Settings',      href: '/go/keycloak/' },
] as const;

const userInitial = (userName.trim().charAt(0) || '?').toUpperCase();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · ODAP Portal</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // No-flash theme — same as legacy Layout.astro.
      (function () {
        try {
          var saved = localStorage.getItem('odap-portal-theme');
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          var theme = saved ?? (prefersLight ? 'light' : 'dark');
          document.documentElement.dataset.theme = theme;
        } catch (e) { /* localStorage unavailable */ }
      })();
    </script>
    <script is:inline>
      // ─── Embed-shell rewrite ───
      // Convert any anchor pointing at a known service-subdomain
      // (https://<svc>.<tld>[:port]/<path>) into a portal-relative
      // /embed/<id>/?path=<path> link, so every click stays inside the
      // unified shell with its top-bar. Runs on ALL hosts (k3d + cloud)
      // — covers role-shortcuts (build-time helper missed deep-links),
      // MDX academy content, /go/<svc>/-fallback anchors, and any
      // hardcoded URL we may add later.
      //
      // Keep EMBED_MAP aligned with components.ts entries that have
      // `embed.mode === 'subdomain'`. Path-routed services are already
      // portal-relative (/grafana etc) and don't need rewriting.
      // .embed-topbar links (in EmbedLayout) are skipped so the
      // "open in nieuw tabblad"-knop blijft to the service-subdomein
      // wijzen.
      (function () {
        var EMBED_MAP = {
          'airflow': 'airflow',
          'superset': 'superset',
          'powerbi': 'powerbi',
          'grafana': 'grafana',
          'prometheus': 'prometheus',
          'openmetadata': 'openmetadata',
          'jupyter': 'jupyter',
          'minio-console': 'minio',
          'multica': 'multica',
          'nanitics': 'nanitics',
          'opensearch': 'opensearch',
          'spark': 'spark'
        };
        var TLD_RE = /^https?:\/\/([a-z0-9-]+)\.(odap-platform\.local|eu-sovereigndataplatform\.com|freshstackable\.com)(:\d+)?(\/[^\s]*)?$/;

        function toEmbedHref(href) {
          var m = href.match(TLD_RE);
          if (!m) return null;
          var id = EMBED_MAP[m[1]];
          if (!id) return null;
          var pathPart = m[4] || '/';
          if (pathPart === '/' || pathPart === '') return '/embed/' + id + '/';
          return '/embed/' + id + '/?path=' + encodeURIComponent(pathPart);
        }

        function rewriteEmbed() {
          var anchors = document.querySelectorAll('a[href]');
          for (var i = 0; i < anchors.length; i++) {
            var a = anchors[i];
            if (a.closest && a.closest('.embed-topbar')) continue;
            if (!/^https?:\/\//i.test(a.href)) continue;
            var embed = toEmbedHref(a.href);
            if (embed) {
              a.href = embed;
              // Drop target=_blank/_rel so the link opens inline in
              // de portal-shell ipv in een nieuw tabblad.
              a.removeAttribute('target');
              a.removeAttribute('rel');
            }
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', rewriteEmbed);
        } else {
          rewriteEmbed();
        }
        new MutationObserver(rewriteEmbed).observe(document.documentElement,
          { childList: true, subtree: true });
        // Click-time safety net voor anchors die programmatisch worden
        // gezet vlak for the klik (MutationObserver mist die race).
        document.addEventListener('click', function (ev) {
          var a = ev.target && ev.target.closest && ev.target.closest('a[href]');
          if (!a) return;
          if (a.closest && a.closest('.embed-topbar')) return;
          var embed = toEmbedHref(a.href);
          if (embed) {
            a.href = embed;
            a.removeAttribute('target');
            a.removeAttribute('rel');
          }
        }, true);
      })();

      // ─── Cross-environment URL rewrite ───
      // The same Astro build serves k3d (*.odap.local:8443), AKS
      // public DNS (*.example.com:443), and StackIT SKE
      // (*.example.com:443). Component-, role-shortcut, and academy
      // hrefs are build-time hardcoded as https://<svc>.odap.local:8443;
      // on a cloud host we rewrite to https://<svc>.<that-cloud-tld> (port 443).
      // Runs AFTER embed-rewrite — only non-embedded URLs (keycloak admin,
      // /go/<svc>/ fallbacks) reach this point.
      (function () {
        var host = window.location.hostname;

        var CLOUD_TLDS = ['example.com', 'example.com'];
        var targetTld = null;
        for (var t = 0; t < CLOUD_TLDS.length; t++) {
          if (host === CLOUD_TLDS[t] || host.endsWith('.' + CLOUD_TLDS[t])) {
            targetTld = CLOUD_TLDS[t]; break;
          }
        }
        if (!targetTld) return;

        // Subdomains that DON'T have a public cloud counterpart.
        var KEEP_LOCAL = ['multica', 'nanitics'];

        function rewriteHref(href) {
          var m = href.match(/:\/\/([a-z0-9-]+)\.odap-platform\.local(:8443)?/);
          if (m && KEEP_LOCAL.indexOf(m[1]) !== -1) return href;
          return href
            .replace(/:\/\/([a-z0-9-]+)\.odap-platform\.local(:8443)?/g,
                     '://$1.' + targetTld);
        }

        function rewrite() {
          var anchors = document.querySelectorAll('a[href*="odap.local"]');
          for (var i = 0; i < anchors.length; i++) {
            var a = anchors[i];
            if (!/^https?:\/\//i.test(a.href)) continue;
            a.href = rewriteHref(a.href);
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', rewrite);
        } else {
          rewrite();
        }
        new MutationObserver(rewrite).observe(document.documentElement,
          { childList: true, subtree: true });

        document.addEventListener('click', function (ev) {
          var a = ev.target && ev.target.closest && ev.target.closest('a[href*="odap.local"]');
          if (a && /^https?:\/\//i.test(a.href)) a.href = rewriteHref(a.href);
        }, true);
      })();
    </script>
  </head>

  <body class="shell" data-rail="collapsed" data-embed-mode={embedMode ? 'true' : undefined}>
    <!-- ─── LEFT RAIL ─────────────────────────────────────── -->
    <aside class="rail" aria-label="Hoofdnavigatie">
      <a class="rail-brand" href="/" aria-label="ODAP Portal">
        <span class="rail-brand-mark">ODAP</span>
        <span class="rail-brand-text"><b>Platform</b> <span class="rail-brand-sub">v2</span></span>
      </a>

      <nav class="rail-nav">
        {RAIL_MAIN.map((s) => (
          <>
            <a
              class:list={['rail-link', { 'rail-link--active': s.id === activeSection }]}
              href={s.href}
              title={('title' in s ? (s as { title: string }).title : s.label)}
              data-section={s.id}
            >
              <span class="rail-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={RAIL_ICONS[s.id]} />
              </span>
              <span class="rail-label">{s.label}</span>
            </a>
            {'children' in s && (s as { children?: readonly { id: string; label: string; href: string; external?: boolean }[] }).children && (
              <div class="rail-sublist" data-parent={s.id}>
                {(s as { children: readonly { id: string; label: string; href: string; external?: boolean }[] }).children.map((c) => (
                  <a
                    class:list={[
                      'rail-sublink',
                      {
                        'rail-sublink--active':
                          s.id === activeSection && c.id === activeSubsection,
                      },
                    ]}
                    href={c.href}
                    title={c.label}
                    data-subsection={c.id}
                    target={c.external ? '_blank' : undefined}
                    rel={c.external ? 'noopener noreferrer' : undefined}
                  >
                    <span class="rail-sublink-bullet" aria-hidden="true"></span>
                    <span class="rail-label">
                      {c.label}
                      {c.external && <span class="rail-sublink-ext" aria-hidden="true"> ↗</span>}
                    </span>
                  </a>
                ))}
              </div>
            )}
          </>
        ))}
      </nav>

      <nav class="rail-nav rail-nav--footer">
        {RAIL_FOOT.map((s) => (
          <a
            class:list={['rail-link', { 'rail-link--active': s.id === activeSection }]}
            href={s.href}
            title={s.label}
            data-section={s.id}
          >
            <span class="rail-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={RAIL_ICONS[s.id]} />
            </span>
            <span class="rail-label">{s.label}</span>
          </a>
        ))}
      </nav>
    </aside>

    <!-- ─── TOP BAR ──────────────────────────────────────── -->
    <header class="topbarv2">
      <!-- Search trigger — opens command palette -->
      <button class="topbarv2-search" type="button" data-open-cmdk>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
        </svg>
        <span class="topbarv2-search-placeholder">Search dashboards, DAGs, tables, notebooks…</span>
        <kbd class="topbarv2-kbd">⌘K</kbd>
      </button>

      <div class="topbarv2-right">
        <!-- + New -->
        <div class="topbarv2-dropdown" data-dropdown="create">
          <button class="topbarv2-cta" type="button" data-dropdown-toggle="create">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
            <span>New</span>
          </button>
          <div class="topbarv2-panel topbarv2-panel--right" role="menu">
            <a class="topbarv2-item" href="/embed/superset/?path=/sqllab/">
              <span class="topbarv2-item-icon" data-color="query">SQL</span>
              <span class="topbarv2-item-text"><b>SQL query</b><em>Open Superset SQLLab</em></span>
            </a>
            <a class="topbarv2-item" href="/embed/jupyter/?path=/lab/">
              <span class="topbarv2-item-icon" data-color="notebook">NB</span>
              <span class="topbarv2-item-text"><b>Notebook</b><em>New in Jupyter</em></span>
            </a>
            <a class="topbarv2-item" href="/embed/superset/?path=/dashboard/list/">
              <span class="topbarv2-item-icon" data-color="dashboard">DSH</span>
              <span class="topbarv2-item-text"><b>Dashboard</b><em>Superset chart + dashboard</em></span>
            </a>
            <a class="topbarv2-item" href="/csv-upload/">
              <span class="topbarv2-item-icon" data-color="table">CSV</span>
              <span class="topbarv2-item-text"><b>Job sources</b><em>Configure daily extraction</em></span>
            </a>
            <hr class="topbarv2-sep" />
            <a class="topbarv2-item" href="/access-request/">
              <span class="topbarv2-item-icon" data-color="admin">+A</span>
              <span class="topbarv2-item-text"><b>Request access</b><em>Catalog or schema</em></span>
            </a>
          </div>
        </div>

        <!-- Notifications — React Island. Bell button, unread dot,
             dropdown panel and the mock SSE-feed all live in
             NotificationBell.tsx. Real /api/portal/events SSE follows
             in fase D. -->
        <NotificationBell client:load />

        <!-- Persona indicator — read-only display van de SSO-rol.
             Vroeger een dropdown waarmee je handmatig een andere persona kon
             kiezen, maar in SSO-modus is dat semantisch fout: de rol komt uit
             Keycloak-claims. renderWho() updatet dot+label uit sessionStorage. -->
        <div class="topbarv2-persona" title={currentPersona.label}>
          <span class="topbarv2-persona-dot" style={`background: ${currentPersona.color}`}>{currentPersona.initials}</span>
          <span class="topbarv2-persona-label">{currentPersona.label}</span>
        </div>

        <!-- Theme toggle -->
        <button class="topbarv2-icon-btn" type="button" data-theme-toggle aria-label="Toggle theme">
          <svg class="topbarv2-theme-icon topbarv2-icon-sun"  width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" /></svg>
          <svg class="topbarv2-theme-icon topbarv2-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        </button>

        <!-- User pill — opens dropdown with account info + logout -->
        <div class="topbarv2-dropdown" data-dropdown="user">
          <button
            class="topbarv2-user"
            type="button"
            data-dropdown-toggle="user"
            data-who-avatar
            title={userName}
            aria-label={userName}
          >{userInitial}</button>
          <div class="topbarv2-panel topbarv2-panel--right topbarv2-panel--wide" role="menu">
            <div class="topbarv2-user-info">
              <span class="topbarv2-user-info-avatar" data-who-avatar-large>{userInitial}</span>
              <span class="topbarv2-user-info-text">
                <b data-who-name>{userName}</b>
                <em data-who-email>not signed in</em>
              </span>
            </div>
            <hr class="topbarv2-sep" />
            <a class="topbarv2-item" href="/me/">
              <span class="topbarv2-item-icon" data-color="dashboard">ME</span>
              <span class="topbarv2-item-text"><b>My workspace</b><em>Role, capabilities, shortcuts</em></span>
            </a>
            <a class="topbarv2-item" href="/learn/">
              <span class="topbarv2-item-icon" data-color="notebook">AC</span>
              <span class="topbarv2-item-text"><b>Academy</b><em>Your learning path</em></span>
            </a>
            <hr class="topbarv2-sep" />
            <a class="topbarv2-item" href="#logout" data-who-logout>
              <span class="topbarv2-item-icon" data-color="admin">↗</span>
              <span class="topbarv2-item-text"><b>Sign out</b><em>End session</em></span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- ─── MAIN ─────────────────────────────────────────── -->
    <main class="shell-main">
      <slot />
      {!embedMode && (
        <footer class="shell-footer">
          <div class="shell-footer-inner">
            <span class="mono">Reference implementation · synthetische data</span>
            <span class="shell-footer-links">
              <a href="/learn/">Job-market Academy</a>
              <span aria-hidden="true">·</span>
              <a href="https://github.com/karelgo/open-data-analytics-platform"
                 target="_blank" rel="noopener noreferrer">Repo ↗</a>
              <span aria-hidden="true">·</span>
              <a href="/styleguide/">Styleguide</a>
            </span>
          </div>
        </footer>
      )}
    </main>

    <!-- ─── COMMAND PALETTE (Cmd+K) ──────────────────────── -->
    <!-- React Island. Manages its own open/close/query/selected state.
         Listens for the 'cmdk-open' window event (dispatched by the
         topbar search button) and Cmd+K / Ctrl+K keypresses. CSS is
         shared with the legacy version below (.cmdk-*). -->
    <CommandPalette client:load />


    <script>
      // ───────────────────────────────────────────────────
      // Theme toggle (identical to legacy Layout.astro)
      // ───────────────────────────────────────────────────
      const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      themeBtn?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
        const next = cur === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('odap-portal-theme', next); } catch {}
      });

      // ───────────────────────────────────────────────────
      // Rail hover-expand: body[data-rail] drives main+topbar shift
      // ───────────────────────────────────────────────────
      const rail = document.querySelector<HTMLElement>('.rail');
      rail?.addEventListener('mouseenter', () => {
        document.body.dataset.rail = 'expanded';
      });
      rail?.addEventListener('mouseleave', () => {
        document.body.dataset.rail = 'collapsed';
      });

      // ───────────────────────────────────────────────────
      // Dropdown toggles — single open at a time, click-outside closes
      // ───────────────────────────────────────────────────
      function closeAllDropdowns(): void {
        document.querySelectorAll('.topbarv2-dropdown[data-open]').forEach((d) => {
          d.removeAttribute('data-open');
        });
      }
      document.querySelectorAll('[data-dropdown-toggle]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const dd = (btn as HTMLElement).closest('.topbarv2-dropdown') as HTMLElement | null;
          if (!dd) return;
          const wasOpen = dd.hasAttribute('data-open');
          closeAllDropdowns();
          if (!wasOpen) dd.setAttribute('data-open', '');
        });
      });
      document.addEventListener('click', (e) => {
        // Only close if click is OUTSIDE any open dropdown panel
        const target = e.target as HTMLElement;
        if (!target.closest('.topbarv2-dropdown[data-open]')) closeAllDropdowns();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAllDropdowns();
      });

      // ───────────────────────────────────────────────────
      // Favorites toggle — delegated click handler
      // ───────────────────────────────────────────────────
      // Buttons in tiles (ItemTile.astro) carry data-action="favorite-toggle"
      // plus data-item-* attrs for the backend payload. We catch clicks at
      // document level so any tile (SSR or client-side rendered) participates
      // without per-tile JS. Optimistic UI: flip aria-pressed first, then
      // POST/DELETE; revert on failure.
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const btn = target?.closest<HTMLButtonElement>(
          'button[data-action="favorite-toggle"]'
        );
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();

        const wasStarred = btn.getAttribute('aria-pressed') === 'true';
        const newStarred = !wasStarred;
        const key = btn.dataset.itemKey;
        if (!key) return;

        // Optimistic UI flip.
        btn.setAttribute('aria-pressed', String(newStarred));
        btn.setAttribute(
          'aria-label',
          newStarred ? 'Verwijder uit favorieten' : 'Markeer als favoriet',
        );

        const url = newStarred
          ? '/api/portal/favorites'
          : `/api/portal/favorites/${encodeURIComponent(key)}`;
        const method = newStarred ? 'POST' : 'DELETE';
        const body = newStarred
          ? JSON.stringify({
              key,
              type:     btn.dataset.itemType ?? 'dashboard',
              service:  btn.dataset.itemService ?? 'superset',
              title:    btn.dataset.itemTitle ?? '',
              subtitle: btn.dataset.itemSubtitle ?? '',
              href:     btn.dataset.itemHref ?? '',
            })
          : undefined;

        fetch(url, {
          method,
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body,
        })
          .then((r) => {
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
          })
          .catch(() => {
            // Revert on failure (backend down, validation error, etc).
            btn.setAttribute('aria-pressed', String(wasStarred));
            btn.setAttribute(
              'aria-label',
              wasStarred ? 'Verwijder uit favorieten' : 'Markeer als favoriet',
            );
          });
      });

      // ───────────────────────────────────────────────────
      // Command Palette (Cmd+K) — open trigger only
      // ───────────────────────────────────────────────────
      // The palette itself is a React Island (CommandPalette.tsx) that
      // owns all state, keyboard nav, and filter logic. We just dispatch
      // a 'cmdk-open' event when the topbar search button is clicked;
      // Cmd+K is bound inside the React component.
      document.querySelectorAll('[data-open-cmdk]').forEach((b) => {
        b.addEventListener('click', () => {
          window.dispatchEvent(new Event('cmdk-open'));
        });
      });

      // ───────────────────────────────────────────────────
      // Identity loader — fetch /oauth2/userinfo and update
      // the user pill + persona switcher with the real role.
      // SSR defaults are placeholders; this is the real source
      // of truth in production. Mirrors loadIdentity() in
      // Layout.astro so the v2 shell behaves identically.
      // ───────────────────────────────────────────────────

      // Mirror of the Astro front-matter PERSONAS map so renderWho()
      // can compute label / initials / color for the active role.
      // Eindgebruiker-rollen (WIA, WW, etc.) get a generic info-blue
      // dot — they're not in the workspace-persona switcher but should
      // still render a sensible avatar.
      type PersonaMeta = { label: string; initials: string; color: string };
      const SHELL_PERSONAS: Record<string, PersonaMeta> = {
        data_engineer:            { label: 'Data Engineer',   initials: 'DE', color: 'var(--persona-engineer)' },
        data_analyst:             { label: 'Data Analyst',    initials: 'DA', color: 'var(--persona-analyst)' },
        data_steward:             { label: 'Data Steward',    initials: 'DS', color: 'var(--persona-steward)' },
        researcher:               { label: 'Labour Market Researcher',      initials: 'R',  color: 'var(--persona-scientist)' },
        platform_admin:           { label: 'Platform Admin',  initials: 'PA', color: 'var(--persona-admin)' },
        claims_analyst:          { label: 'Job Market Analyst', initials: 'W',  color: 'var(--accent-info)' },
        fraud_analyst:             { label: 'Source Quality Analyst',    initials: 'W',  color: 'var(--accent-info)' },
        marketing_analyst:           { label: 'Skills Analyst',  initials: 'C',  color: 'var(--accent-info)' },
        finance_analyst:              { label: 'Salary Analyst',     initials: 'F',  color: 'var(--accent-info)' },
        operations_manager:              { label: 'Market Operations',     initials: 'S',  color: 'var(--accent-info)' },
      };
      const KNOWN_ROLES = Object.keys(SHELL_PERSONAS);

      async function loadIdentity(): Promise<void> {
        try {
          const r = await fetch('/oauth2/userinfo', { credentials: 'include' });
          if (!r.ok) return;
          const me = await r.json();
          const groups: string[] = me.groups ?? me.roles ?? [];
          const role = groups.find((g) => KNOWN_ROLES.includes(g));
          if (role) sessionStorage.setItem('odap-portal-role', role);
          const user = me.email ?? me.user ?? null;
          if (user) sessionStorage.setItem('odap-portal-user', user);
          renderWho();
        } catch {
          /* niet ingelogd / lokale dev — laat de SSR-defaults staan */
        }
      }

      function renderWho(): void {
        const role = sessionStorage.getItem('odap-portal-role');
        const user = sessionStorage.getItem('odap-portal-user');

        if (user) {
          const initial = user.trim().charAt(0).toUpperCase();
          document.querySelectorAll<HTMLElement>('[data-who-avatar]').forEach((el) => {
            el.textContent = initial;
            el.title = user;
          });
          document.querySelectorAll<HTMLElement>('[data-who-avatar-large]').forEach((el) => {
            el.textContent = initial;
          });
          // Multiple sinks: user dropdown name + hero greeting <em>. Update all.
          document.querySelectorAll<HTMLElement>('[data-who-name]').forEach((el) => {
            el.textContent = user;
          });
          // Hero greeting comma — empty when no name, ", " when name is known.
          document.querySelectorAll<HTMLElement>('[data-who-prefix]').forEach((el) => {
            el.textContent = ', ';
          });
          const emailEl = document.querySelector<HTMLElement>('[data-who-email]');
          if (emailEl) emailEl.textContent = user;
        }

        if (role && SHELL_PERSONAS[role]) {
          const p = SHELL_PERSONAS[role];
          const personaDot = document.querySelector<HTMLElement>('.topbarv2-persona .topbarv2-persona-dot');
          const personaLabel = document.querySelector<HTMLElement>('.topbarv2-persona-label');
          if (personaDot) {
            personaDot.style.background = p.color;
            personaDot.textContent = p.initials;
          }
          if (personaLabel) personaLabel.textContent = p.label;
        }
      }

      // ───────────────────────────────────────────────────
      // Logout — TLD-aware Keycloak end-session URL.
      // ───────────────────────────────────────────────────
      function buildLogoutUrl(): string {
        const host = window.location.hostname;
        let tld = 'odap.local';
        let port = ':8443';
        if (host.endsWith('.example.com')) {
          tld = 'example.com'; port = '';
        } else if (host.endsWith('.example.com')) {
          tld = 'example.com'; port = '';
        }
        const post = `https://platform.${tld}${port}/`;
        const ks   = `https://keycloak.${tld}${port}/realms/odap/protocol/openid-connect/logout` +
                     `?client_id=portal&post_logout_redirect_uri=${encodeURIComponent(post)}`;
        return `/oauth2/sign_out?rd=${encodeURIComponent(ks)}`;
      }
      document.querySelectorAll<HTMLAnchorElement>('[data-who-logout]').forEach((a) => {
        a.addEventListener('click', (ev) => {
          ev.preventDefault();
          sessionStorage.removeItem('odap-portal-role');
          sessionStorage.removeItem('odap-portal-user');
          window.location.href = buildLogoutUrl();
        });
      });

      renderWho();      // paint from sessionStorage first (no flicker)
      loadIdentity();   // then refresh from /oauth2/userinfo
    </script>

    <!-- ─── GLOBAL SHELL STYLES ──────────────────────────── -->
    <style is:global>
      /* ─── Body / layout grid ─── */
      body.shell {
        background: var(--shell-bg);
        min-height: 100vh;
      }
      .shell-main {
        margin-left: var(--sidebar-w-collapsed);
        padding-top: var(--topbar-h);
        min-height: 100vh;
        transition: margin-left var(--motion-base);
      }
      body.shell[data-rail="expanded"] .shell-main {
        margin-left: var(--sidebar-w-expanded);
      }

      /* Embed mode: full-viewport iframe with a sub-bar. shell-main becomes
         a flex column so the slotted content (sub-bar + iframe wrapper)
         can fill the remaining viewport without overflowing. */
      body.shell[data-embed-mode="true"] {
        overflow: hidden;
      }
      body.shell[data-embed-mode="true"] .shell-main {
        min-height: 0;
        height: 100vh;
        padding-top: var(--topbar-h);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      /* ─── Left rail ─── */
      .rail {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--sidebar-w-collapsed);
        background: var(--shell-rail-bg);
        border-right: 1px solid var(--shell-rail-line);
        display: flex;
        flex-direction: column;
        z-index: 20;
        transition: width var(--motion-base), box-shadow var(--motion-base);
        overflow: hidden;
      }
      .rail:hover {
        width: var(--sidebar-w-expanded);
        box-shadow: 8px 0 32px -16px rgba(0, 0, 0, 0.5);
      }

      .rail-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        height: var(--topbar-h);
        padding: 0 14px;
        border-bottom: 1px solid var(--shell-rail-line);
        text-decoration: none;
        flex-shrink: 0;
      }
      .rail-brand:hover { text-decoration: none; }
      .rail-brand-mark {
        width: 26px;
        height: 26px;
        border-radius: var(--radius-sm);
        background: var(--accent);
        color: var(--accent-ink);
        font-weight: var(--weight-bold);
        font-size: 9px;
        letter-spacing: 0.04em;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .rail-brand-text {
        color: var(--ink-1);
        font-size: var(--text-meta);
        white-space: nowrap;
        opacity: 0;
        transition: opacity var(--motion-fast);
      }
      .rail-brand-text b { font-weight: var(--weight-semibold); }
      .rail-brand-sub { color: var(--ink-3); font-family: var(--font-mono); font-size: 11px; margin-left: 2px; }
      .rail:hover .rail-brand-text { opacity: 1; }

      .rail-nav {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: var(--space-3) var(--space-2);
      }
      .rail-nav--footer {
        margin-top: auto;
        border-top: 1px solid var(--shell-rail-line);
        padding-bottom: var(--space-4);
      }

      .rail-link {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 8px 10px;
        border-radius: var(--radius-sm);
        color: var(--ink-3);
        text-decoration: none;
        font-size: var(--text-meta);
        white-space: nowrap;
        position: relative;
        transition: background var(--motion-fast), color var(--motion-fast);
      }
      .rail-link:hover {
        background: var(--bg-sunken);
        color: var(--ink-1);
        text-decoration: none;
      }
      .rail-link--active {
        color: var(--ink-1);
        background: color-mix(in oklch, var(--accent) 14%, transparent);
      }
      .rail-link--active::before {
        content: "";
        position: absolute;
        left: -10px;
        top: 6px;
        bottom: 6px;
        width: 3px;
        border-radius: 0 2px 2px 0;
        background: var(--accent);
      }
      .rail-icon {
        display: inline-flex;
        width: 22px;
        height: 22px;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .rail-label {
        opacity: 0;
        transition: opacity var(--motion-fast);
      }
      .rail:hover .rail-label { opacity: 1; }

      /* ─── Rail sub-list (Observability → Grafana / Prometheus / OpenSearch) ─── */
      /* Indented under the parent icon. Hidden in collapsed mode (no vertical
         space + opacity 0) and revealed on rail:hover. The vertical
         border-left acts as a visual "branch" connecting children to parent.
         Sublinks have smaller font, a tiny bullet dot, and inherit the
         active-state colour scheme. */
      .rail-sublist {
        display: flex;
        flex-direction: column;
        gap: 1px;
        margin: 0 6px 4px 21px;
        padding-left: 10px;
        border-left: 1px solid var(--shell-rail-line);
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: max-height var(--motion-base), opacity var(--motion-fast),
                    margin-bottom var(--motion-base);
      }
      .rail:hover .rail-sublist {
        max-height: 160px;
        opacity: 1;
      }

      .rail-sublink {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 8px;
        border-radius: var(--radius-sm);
        color: var(--ink-3);
        font-size: 12px;
        text-decoration: none;
        white-space: nowrap;
        transition: background var(--motion-fast), color var(--motion-fast);
      }
      .rail-sublink:hover {
        background: var(--bg-sunken);
        color: var(--ink-1);
        text-decoration: none;
      }
      .rail-sublink--active {
        color: var(--ink-1);
        background: color-mix(in oklch, var(--accent) 10%, transparent);
      }
      .rail-sublink-bullet {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--ink-4);
        flex-shrink: 0;
      }
      .rail-sublink:hover .rail-sublink-bullet,
      .rail-sublink--active .rail-sublink-bullet {
        background: var(--accent);
      }
      /* External-indicator arrow — shown only when a sub-rail entry has
         external:true. Visually signals that the link opens a new tab. */
      .rail-sublink-ext {
        color: var(--ink-4);
        font-size: 10px;
      }

      /* ─── Top bar ─── */
      .topbarv2 {
        position: fixed;
        top: 0;
        left: var(--sidebar-w-collapsed);
        right: 0;
        height: var(--topbar-h);
        background: color-mix(in oklch, var(--bg-elev) 92%, transparent);
        backdrop-filter: saturate(140%) blur(8px);
        -webkit-backdrop-filter: saturate(140%) blur(8px);
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding: 0 var(--space-5);
        z-index: 15;
        transition: left var(--motion-base);
      }
      body.shell[data-rail="expanded"] .topbarv2 {
        left: var(--sidebar-w-expanded);
      }

      .topbarv2-search {
        flex: 1;
        max-width: 560px;
        display: flex;
        align-items: center;
        gap: var(--space-3);
        background: var(--bg-sunken);
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        color: var(--ink-3);
        height: 34px;
        padding: 0 var(--space-3);
        font-size: var(--text-meta);
        cursor: pointer;
        transition: border-color var(--motion-fast), background var(--motion-fast);
        font-family: var(--font-sans);
      }
      .topbarv2-search:hover {
        border-color: var(--ink-4);
        background: var(--bg-elev);
        color: var(--ink-2);
      }
      .topbarv2-search-placeholder {
        flex: 1;
        text-align: left;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .topbarv2-kbd {
        background: var(--kbd-bg);
        border: 1px solid var(--kbd-line);
        border-radius: var(--radius-sm);
        padding: 1px 6px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--ink-3);
        flex-shrink: 0;
      }

      .topbarv2-right {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-left: auto;
      }

      .topbarv2-cta {
        height: 32px;
        padding: 0 12px;
        font-size: var(--text-meta);
        font-weight: var(--weight-medium);
        background: var(--accent);
        color: var(--accent-ink);
        border: 0;
        border-radius: var(--radius-sm);
        display: inline-flex;
        align-items: center;
        gap: 6px;
