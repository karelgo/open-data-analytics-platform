---
import ShellLayout from '../layouts/ShellLayout.astro';

// Browser-side any-file upload naar MinIO met optionele Delta-conversie.
//
// Flow:
//   1. GET /api/auth/token      → access-token uit oauth2-proxy.
//   2. POST minio/?Action=AssumeRoleWithWebIdentity → temp S3-creds.
//   3. PUT  minio/odap-staging/uploads/<email>/<ts>/<filename>.
//   4. (Tabulair) POST /api/airflow/trigger-convert → bridge sidecar
//      valideert + roept Airflow REST aan voor convert_to_delta.
//
// Sanitisation van email → path-segment MOET matchen met
// portal/scripts/airflow-bridge.py (sanitize_email).
---
<ShellLayout title="Upload" activeSection="workspace">
  <section class="up">
    <h1 class="up-title">Upload</h1>
    <p class="up-sub">Bestand → MinIO. Tabulair → optioneel Delta in bronze.</p>

    <label id="drop-zone" class="up-drop" for="file-input" data-state="idle">
      <input id="file-input" type="file" hidden />
      <span class="up-drop-title">Klik of sleep een bestand</span>
      <span class="up-drop-sub">elk type · max 500 MB</span>
    </label>

    <div id="upload-status" class="up-status" role="status" aria-live="polite" hidden>
      <div class="up-status-row">
        <span class="up-status-label" id="status-label">Wachten…</span>
        <span class="up-status-pct mono" id="status-pct"></span>
      </div>
      <div class="up-progress" aria-hidden="true">
        <div class="up-progress-bar" id="progress-bar"></div>
      </div>
      <p class="up-status-detail" id="status-detail"></p>
    </div>

    <div id="convert" class="up-convert" hidden>
      <div class="up-form-row">
        <span class="up-form-prefix mono">bronze.</span>
        <input id="fld-schema" class="up-input mono" type="text" value="sandbox"
               pattern="^[a-z][a-z0-9_]{0,62}$" required
               aria-label="Target schema" />
        <span class="up-form-sep mono">.</span>
        <input id="fld-table" class="up-input mono" type="text"
               pattern="^[a-z][a-z0-9_]{0,62}$" required
               aria-label="Target tabel" placeholder="tabel" />
        <button id="convert-btn" type="button" class="btn btn--accent" disabled>
          Convert to Delta →
        </button>
      </div>
      <p id="convert-feedback" class="up-feedback" role="status" aria-live="polite"></p>
    </div>

  </section>

  <script>
    import { AwsClient } from 'aws4fetch';

    const MINIO_S3_API_MAP: Record<string, string> = {
      'platform.odap.local':           'https://minio.odap.local:8443',
      'platform.example.com': 'https://minio-api.example.com',
      'platform.example.com':           'https://minio-api.example.com',
    };
    const MINIO_CONSOLE_MAP: Record<string, string> = {
      'platform.odap.local':           'https://minio-console.odap.local:8443',
      'platform.example.com': 'https://minio-console.example.com',
      'platform.example.com':           'https://minio.example.com',
    };
    const AIRFLOW_MAP: Record<string, string> = {
      'platform.odap.local':           'https://platform.odap.local:8443/airflow',
      'platform.example.com': 'https://platform.example.com/airflow',
      'platform.example.com':           'https://platform.example.com/airflow',
    };
    const minioApi     = MINIO_S3_API_MAP[window.location.hostname]    ?? MINIO_S3_API_MAP['platform.odap.local'];
    const minioConsole = MINIO_CONSOLE_MAP[window.location.hostname]   ?? MINIO_CONSOLE_MAP['platform.odap.local'];
    const airflowBase  = AIRFLOW_MAP[window.location.hostname]         ?? AIRFLOW_MAP['platform.odap.local'];

    const STAGING_BUCKET = 'odap-staging';
    const MAX_BYTES = 500 * 1024 * 1024;
    const CONVERT_DAG_ID = 'convert_to_delta';

    type Convertible = 'csv' | 'tsv' | 'json' | 'ndjson' | 'parquet';
    const EXT_TO_FORMAT: Record<string, Convertible> = {
      csv: 'csv', tsv: 'tsv', tab: 'tsv',
      json: 'json', ndjson: 'ndjson', jsonl: 'ndjson',
      parquet: 'parquet', pq: 'parquet',
    };

    // Sanitisation — MOET matchen met airflow-bridge.py sanitize_email().
    const sanitizeEmail = (email: string): string =>
      email.trim().toLowerCase().replace(/@/g, '_at_').replace(/\./g, '_').replace(/[^a-z0-9_]/g, '_');

    const sanitizeFileName = (name: string): string =>
      name.replace(/[^A-Za-z0-9._-]/g, '_').replace(/^_+|_+$/g, '');

    const detectFormat = (name: string): Convertible | null => {
      const m = name.toLowerCase().match(/\.([a-z0-9]+)$/);
      return m ? (EXT_TO_FORMAT[m[1]] ?? null) : null;
    };

    const defaultTableName = (fileName: string): string => {
      const base = fileName.replace(/\.[^.]+$/, '').toLowerCase();
      const snake = base.replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
      if (!snake || !/^[a-z]/.test(snake)) return `tbl_${snake || 'upload'}`.slice(0, 63);
      return snake.slice(0, 63);
    };

    // ── DOM refs ────────────────────────────────────────────────────────────
    const dropZone   = document.getElementById('drop-zone') as HTMLLabelElement | null;
    const fileInput  = document.getElementById('file-input') as HTMLInputElement | null;
    const statusBox  = document.getElementById('upload-status') as HTMLDivElement | null;
    const statusLbl  = document.getElementById('status-label');
    const statusPct  = document.getElementById('status-pct');
    const statusDet  = document.getElementById('status-detail');
    const progBar    = document.getElementById('progress-bar') as HTMLDivElement | null;

    const convertBox  = document.getElementById('convert') as HTMLElement | null;
    const convertBtn  = document.getElementById('convert-btn') as HTMLButtonElement | null;
    const convertFb   = document.getElementById('convert-feedback');
    const fldSchema   = document.getElementById('fld-schema') as HTMLInputElement | null;
    const fldTable    = document.getElementById('fld-table')  as HTMLInputElement | null;

    type UploadedFile = {
      objectKey: string;
      fileName:  string;
      format:    Convertible | null;
    };
    let lastUpload: UploadedFile | null = null;

    function setState(state: 'idle' | 'busy' | 'ok' | 'err',
                      label: string, detail = '', pct = 0) {
      if (!statusBox) return;
      statusBox.hidden = false;
      dropZone?.setAttribute('data-state', state);
      if (statusLbl) statusLbl.textContent = label;
      if (statusPct) statusPct.textContent = pct > 0 ? `${pct.toFixed(0)} %` : '';
      if (statusDet) statusDet.innerHTML = detail;
      if (progBar)   progBar.style.width = `${pct}%`;
    }

    function escapeHtml(s: string): string {
      return s.replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[c]!));
    }

    function minioBrowseUrl(objectKey: string): string {
      const prefix = objectKey.split('/').slice(0, -1).join('/') + '/';
      const b64 = btoa(prefix).replace(/=+$/, '');
      return `${minioConsole}/browser/${STAGING_BUCKET}/${b64}`;
    }

    function revealConvert(file: UploadedFile) {
      if (!convertBox) return;
      if (!file.format) { convertBox.hidden = true; return; }
      convertBox.hidden = false;
      if (fldTable) {
        fldTable.value = defaultTableName(file.fileName);
        fldTable.dispatchEvent(new Event('input'));
      }
      const recheck = () => {
        if (!convertBtn) return;
        convertBtn.disabled =
          !(fldSchema?.validity.valid ?? false) || !(fldTable?.validity.valid ?? false);
      };
      [fldSchema, fldTable].forEach((el) => el?.addEventListener('input', recheck));
      recheck();
    }

    // ── Auth / STS ─────────────────────────────────────────────────────────
    let cachedEmail: string | null = null;
    async function fetchEmail(): Promise<string> {
      if (cachedEmail) return cachedEmail;
      const r = await fetch('/oauth2/userinfo', { credentials: 'same-origin', cache: 'no-store' });
      if (!r.ok) throw new Error(`/oauth2/userinfo: HTTP ${r.status} — ben je ingelogd?`);
      const data = await r.json();
      const email = (data.email || data.user || '').toString().toLowerCase();
      if (!email) throw new Error('Geen email in oauth2-proxy userinfo.');
      cachedEmail = email;
      return email;
    }

    async function fetchAccessToken(forceFresh = false): Promise<string> {
      const url = forceFresh ? `/api/auth/token?t=${Date.now()}` : '/api/auth/token';
      const r = await fetch(url, {
        credentials: 'same-origin', cache: 'no-store',
        headers: { 'Cache-Control': 'no-cache' },
      });
      if (!r.ok) throw new Error(`/api/auth/token: HTTP ${r.status} — ben je ingelogd?`);
      const token = (await r.text()).trim();
      if (!token) throw new Error('Geen access-token in sessie.');
      return token;
    }
    const isExpiredTokenError = (err: unknown): boolean => {
      const msg = err instanceof Error ? err.message : String(err);
      return /Token is expired|ExpiredToken|InvalidWebIdentityToken/i.test(msg);
    };

    type TempCreds = { accessKeyId: string; secretAccessKey: string; sessionToken: string; expiration: string };
    async function assumeRoleWithWebIdentity(token: string): Promise<TempCreds> {
      const body = new URLSearchParams({
        Action: 'AssumeRoleWithWebIdentity', Version: '2011-06-15',
        DurationSeconds: '3600', WebIdentityToken: token,
      });
      const r = await fetch(`${minioApi}/`, {
        method: 'POST', body, credentials: 'omit',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      });
      const text = await r.text();
      if (!r.ok) throw new Error(`STS HTTP ${r.status}: ${text.slice(0, 300)}`);
      const xml = new DOMParser().parseFromString(text, 'application/xml');
      const get = (tag: string) => xml.getElementsByTagName(tag)[0]?.textContent ?? '';
      const creds: TempCreds = {
        accessKeyId:     get('AccessKeyId'),
        secretAccessKey: get('SecretAccessKey'),
        sessionToken:    get('SessionToken'),
        expiration:      get('Expiration'),
      };
      if (!creds.accessKeyId || !creds.secretAccessKey) {
        throw new Error('STS antwoord miste credentials — controleer Keycloak policy-claim (csv-uploader).');
      }
      return creds;
    }

    function objectKeyFor(email: string, fileName: string): string {
      const ts = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d+Z$/, 'Z');
      const safe = sanitizeFileName(fileName) || 'upload.bin';
      return `uploads/${sanitizeEmail(email)}/${ts}/${safe}`;
    }

    async function putWithProgress(
      signedReq: Request, file: File, onProgress: (pct: number) => void,
    ): Promise<void> {
      return new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open(signedReq.method, signedReq.url, true);
        signedReq.headers.forEach((v, k) => {
          const lk = k.toLowerCase();
          if (lk === 'host' || lk === 'content-length') return;
          try { xhr.setRequestHeader(k, v); } catch { /* ignore */ }
        });
        xhr.upload.onprogress = (e) => { if (e.lengthComputable) onProgress((e.loaded / e.total) * 100); };
        xhr.onload = () => {
          if (xhr.status >= 200 && xhr.status < 300) resolve();
          else reject(new Error(`PUT HTTP ${xhr.status}: ${xhr.responseText.slice(0, 300)}`));
        };
        xhr.onerror = () => reject(new Error('Netwerk- of CORS-fout tijdens upload.'));
        xhr.send(file);
      });
    }

    // ── Upload ──────────────────────────────────────────────────────────────
    async function handleFile(file: File) {
      if (file.size > MAX_BYTES) {
        setState('err', 'Te groot',
          `Max 500 MB; dit bestand is ${(file.size / 1024 / 1024).toFixed(1)} MB.`);
        return;
      }
      // Reset convert UI on fresh upload.
      if (convertBox) convertBox.hidden = true;
      if (convertFb)  convertFb.textContent = '';
      lastUpload = null;

      let email: string;
      try {
        setState('busy', 'Sessie checken…');
        email = await fetchEmail();
      } catch (err) {
        setState('err', 'Niet ingelogd', escapeHtml(err instanceof Error ? err.message : String(err)));
        return;
      }

      const key = objectKeyFor(email, file.name);
      const url = `${minioApi}/${STAGING_BUCKET}/${key}`;
      const contentType = file.type || 'application/octet-stream';

      try {
        setState('busy', 'Token ophalen…');
        let token = await fetchAccessToken();

        setState('busy', 'STS-credentials…');
        let creds: TempCreds;
        try {
          creds = await assumeRoleWithWebIdentity(token);
        } catch (err) {
          if (!isExpiredTokenError(err)) throw err;
          // Eerste retry: cache-bust /api/auth/token. Werkt als oauth2-proxy
          // intussen z'n cookie_refresh-cycle heeft gedraaid.
          setState('busy', 'Token vernieuwen…');
          token = await fetchAccessToken(true);
          try {
            creds = await assumeRoleWithWebIdentity(token);
          } catch (err2) {
            if (!isExpiredTokenError(err2)) throw err2;
            // Nog steeds verlopen — oauth2-proxy heeft 'm niet ververst.
            // Forceer full re-auth via Keycloak round-trip; daarna komen we
            // terug op deze pagina met verse tokens.
            setState('err', 'Sessie verlopen',
              'Je wordt heel even doorgestuurd om opnieuw in te loggen…');
            const rd = encodeURIComponent(window.location.pathname + window.location.search);
            window.setTimeout(() => {
              window.location.href = `/oauth2/sign_in?rd=${rd}`;
            }, 700);
            return;
          }
        }

        const aws = new AwsClient({
          accessKeyId:     creds.accessKeyId,
          secretAccessKey: creds.secretAccessKey,
          sessionToken:    creds.sessionToken,
          service:         's3',
          region:          'us-east-1',
        });
        const signed = await aws.sign(url, {
          method: 'PUT', body: file,
          headers: { 'Content-Type': contentType },
        });

        setState('busy', 'Uploaden…');
        await putWithProgress(signed, file, (pct) =>
          setState('busy', 'Uploaden…', `${(file.size / 1024 / 1024).toFixed(2)} MB`, pct));

        const fmt = detectFormat(file.name);
        lastUpload = { objectKey: key, fileName: file.name, format: fmt };

        const mb = (file.size / 1024 / 1024).toFixed(2);
        const browse = minioBrowseUrl(key);
        const detail =
          `<code>${escapeHtml(STAGING_BUCKET)}/${escapeHtml(key)}</code> · ${mb} MB · ` +
          `<a class="up-inline-link" href="${browse}" target="_blank" rel="noopener noreferrer">MinIO ↗</a>` +
          (fmt ? '' : ' · niet-tabulair — geen Delta-conversie');
        setState('ok', fmt ? `Klaar — ${fmt.toUpperCase()} gedetecteerd.` : 'Klaar.', detail, 100);
        revealConvert(lastUpload);
      } catch (err) {
        setState('err', 'Upload mislukt', escapeHtml(err instanceof Error ? err.message : String(err)));
      }
    }

    // ── Convert ─────────────────────────────────────────────────────────────
    function showConvertFb(msg: string, ok = true) {
      if (!convertFb) return;
      convertFb.innerHTML = msg;
      convertFb.dataset.state = ok ? 'ok' : 'err';
    }

    async function triggerConvert() {
      if (!lastUpload || !lastUpload.format) return;
      const schema = fldSchema?.value.trim() ?? '';
      const table  = fldTable?.value.trim()  ?? '';
      if (!schema || !table) {
        showConvertFb('Schema en tabel zijn verplicht.', false);
        return;
      }
      if (convertBtn) convertBtn.disabled = true;
      showConvertFb('Triggeren…');
      try {
        const r = await fetch('/api/airflow/trigger-convert', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            object_key:     lastUpload.objectKey,
            source_format:  lastUpload.format,
            target_catalog: 'bronze',
            target_schema:  schema,
            target_table:   table,
            partition_col:  null,
          }),
        });
        const data = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(data.detail ?? data.msg ?? `HTTP ${r.status}`);
        const runId = data.dag_run_id ?? '';
        const url   = data.airflow_url ?? `${airflowBase}/dags/${CONVERT_DAG_ID}/grid`;
        showConvertFb(
          `Getriggerd · <code>bronze.${escapeHtml(schema)}.${escapeHtml(table)}</code> · ` +
          `<a class="up-inline-link" href="${url}" target="_blank" rel="noopener noreferrer">${escapeHtml(runId || 'open in Airflow')} ↗</a>`,
        );
      } catch (err) {
        showConvertFb(`Trigger mislukt: ${escapeHtml(err instanceof Error ? err.message : String(err))}`, false);
        if (convertBtn) convertBtn.disabled = false;
      }
    }

    // ── Wiring ──────────────────────────────────────────────────────────────
    fileInput?.addEventListener('change', () => {
      const f = fileInput.files?.[0];
      if (f) handleFile(f);
    });

    if (dropZone) {
      ['dragenter', 'dragover'].forEach((ev) =>
        dropZone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropZone.classList.add('up-drop--active');
        }));
      ['dragleave', 'drop'].forEach((ev) =>
        dropZone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropZone.classList.remove('up-drop--active');
        }));
      dropZone.addEventListener('drop', (e) => {
        const dt = (e as DragEvent).dataTransfer;
        const f = dt?.files?.[0];
        if (f) handleFile(f);
      });
    }

    convertBtn?.addEventListener('click', triggerConvert);
  </script>

  <style>
    .up {
      max-width: 640px;
      padding: var(--space-9) 0 var(--space-7);
      display: flex; flex-direction: column;
      gap: var(--space-4);
    }
    .up-title {
      font-size: 32px;
      line-height: var(--leading-h2, 1.2);
      letter-spacing: var(--tracking-h2, -0.01em);
      font-weight: var(--weight-medium);
      color: var(--ink-1);
      margin: 0;
      border: 0; padding: 0;
    }
    .up-sub {
      color: var(--ink-3);
      font-size: var(--text-meta);
      margin: 0 0 var(--space-3);
    }
    .up code {
      background: var(--bg-sunken);
      color: var(--ink-1);
      padding: 1px 6px;
      border-radius: 4px;
      border: 1px solid var(--line);
      font-size: 0.92em;
    }

    /* Drop zone — focal point */
    .up-drop {
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: var(--space-2);
      min-height: 200px;
      border: 1.5px dashed var(--line);
      border-radius: var(--radius-md);
      background: var(--bg-sunken);
      cursor: pointer;
      transition: border-color .15s, background .15s;
      text-align: center;
      padding: var(--space-6) var(--space-4);
    }
    .up-drop:hover, .up-drop.up-drop--active {
      border-color: var(--ink-1);
      background: var(--bg-elev);
    }
    .up-drop[data-state="busy"] { border-style: solid; border-color: var(--ink-2); }
    .up-drop[data-state="ok"]   { border-style: solid; border-color: var(--ink-1); }
    .up-drop[data-state="err"]  { border-style: solid; border-color: #b00020; }
    .up-drop-title {
      color: var(--ink-1);
      font-size: 16px;
      font-weight: var(--weight-medium);
    }
    .up-drop-sub {
      color: var(--ink-3);
      font-size: var(--text-meta);
    }

    /* Status — slim row + thin bar */
    .up-status {
      display: flex; flex-direction: column;
      gap: var(--space-2);
    }
    .up-status-row {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: var(--space-3);
    }
    .up-status-label {
      color: var(--ink-1);
      font-size: var(--text-meta);
      font-weight: var(--weight-medium);
    }
    .up-status-pct {
      color: var(--ink-3);
      font-size: var(--text-eyebrow);
    }
    .up-status-detail {
      color: var(--ink-2);
      font-size: var(--text-meta);
      margin: 0;
      word-break: break-all;
    }
    .up-progress {
      height: 2px;
      background: var(--bg-sunken);
      border-radius: 1px;
      overflow: hidden;
    }
    .up-progress-bar {
      height: 100%;
      width: 0%;
      background: var(--ink-1);
      transition: width .15s linear;
    }

    /* Convert — one-line inline form */
    .up-convert {
      display: flex; flex-direction: column;
      gap: var(--space-2);
    }
    .up-form-row {
      display: flex; align-items: center;
      gap: var(--space-2);
      flex-wrap: wrap;
    }
    .up-form-prefix, .up-form-sep {
      color: var(--ink-3);
      font-size: var(--text-meta);
    }
    .up-input {
      font: inherit;
      font-family: var(--font-mono);
      font-size: var(--text-meta);
      padding: 6px 10px;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: var(--bg-sunken);
      color: var(--ink-1);
      width: 16ch;
      min-width: 8ch;
    }
    .up-input:focus {
      outline: 0;
      border-color: var(--ink-1);
      background: var(--bg-elev);
    }
    .up-input:invalid {
      border-color: #b00020;
    }
    .up-feedback {
      color: var(--ink-2);
      font-size: var(--text-meta);
      margin: 0;
      min-height: 1.4em;
    }
    .up-feedback[data-state="err"] { color: #b00020; }
    .up-feedback[data-state="ok"]  { color: var(--ink-1); }

    .up-inline-link {
      color: var(--ink-1);
      border-bottom: 1px solid var(--line);
      text-decoration: none;
    }
    .up-inline-link:hover { border-bottom-color: var(--ink-1); }
  </style>
</ShellLayout>
