---
// Renders de canonieke gids uit docs/access-request-guide.md als portal-page.
// Bron blijft single-source-of-truth in docs/ (zichtbaar op GitHub + in IDE);
// deze wrapper zorgt dat dezelfde tekst ook via SSO-portaal beschikbaar is
// op /docs/access-request-guide.
//
// Astro markdown-integratie picks up de import omdat vite.server.fs.allow
// '..' en '../..' toestaat (zie astro.config.mjs) — we kunnen dus uit de
// repo-root lezen vanuit deze sub-page.

import ShellLayout from '../../layouts/ShellLayout.astro';
// `@docs` alias → repo's docs/ map (zie astro.config.mjs). Houdt de
// markdown single-source-of-truth: zelfde bron op GitHub + via portal.
import { Content } from '@docs/access-request-guide.md';
---
<ShellLayout title="Access request — gids" activeSection="workspace">
  <article class="doc-prose">
    <header class="doc-head">
      <a href="/access-request" class="doc-back">← Terug to the formulier</a>
    </header>
    <Content />
  </article>
</ShellLayout>

<style is:global>
  .doc-prose {
    max-width: 72ch;
    margin: 1.5rem auto 4rem;
    line-height: 1.6;
    color: var(--ink-1, #111);
  }
  .doc-head {
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }
  .doc-back { color: var(--ink-2, #555); }
  .doc-back:hover { color: var(--accent, #2563eb); }

  .doc-prose h1 {
    font-size: 1.85rem;
    margin: 0.5rem 0 1rem;
  }
  .doc-prose h2 {
    margin-top: 2.25rem;
    font-size: 1.3rem;
    border-bottom: 1px solid var(--line, #e4e4e7);
    padding-bottom: 0.35rem;
  }
  .doc-prose h3 {
    margin-top: 1.5rem;
    font-size: 1.05rem;
  }
  .doc-prose p { margin: 0.75rem 0; }
  .doc-prose ul, .doc-prose ol { padding-left: 1.25rem; }
  .doc-prose li { margin: 0.25rem 0; }
  .doc-prose hr {
    margin: 2rem 0;
    border: none;
    border-top: 1px solid var(--line, #e4e4e7);
  }
  .doc-prose code {
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    background: var(--bg-soft, #f4f4f5);
    border-radius: 3px;
  }
  .doc-prose pre {
    padding: 1rem;
    background: var(--bg-soft, #f4f4f5);
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .doc-prose pre code { background: none; padding: 0; }
  .doc-prose blockquote {
    margin: 1rem 0;
    padding: 0.5rem 1rem;
    border-left: 3px solid var(--accent, #2563eb);
    color: var(--ink-2, #555);
    background: var(--bg-soft, #f4f4f5);
  }
  .doc-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 1rem 0;
  }
  .doc-prose th, .doc-prose td {
    text-align: left;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--line, #e4e4e7);
    vertical-align: top;
  }
  .doc-prose th {
    color: var(--ink-2, #555);
    font-weight: 600;
    border-bottom: 2px solid var(--line, #e4e4e7);
  }
  .doc-prose a { color: var(--accent, #2563eb); }
  .doc-prose a:hover { text-decoration: underline; }
</style>
