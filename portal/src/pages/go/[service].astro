---
import ShellLayout from '../../layouts/ShellLayout.astro';
import { components, isEmbeddable } from '../../data/components';

// Backwards-compat /go/<service>/ — vroegere bookmarks stuurden hier door
// naar het externe service-subdomein. Met de embed-shell sturen we ze nu
// naar /embed/<service-id>/ zodat de UI gehuld blijft in de unified top-bar.
//
// Voor services die NIET embed-baar zijn (Keycloak admin, Trino, NiFi):
// we 302'en naar de oorspronkelijke subdomein-URL als fallback, want
// /embed/<id> toont voor die componenten een "open in nieuw tabblad"-shell.
//
// Voor MinIO is /go/minio/ een aparte pagina met SSO-bootstrap — zie
// /go/minio.astro.

interface ServiceTarget {
  // Component-id in components.ts — bepaalt /embed/<id>/-route + fallback.
  componentId: string;
  // Display-naam tijdens redirect.
  label: string;
  // Optioneel deep-link-pad onder de service-root.
  path?: string;
}

const targets: Record<string, ServiceTarget> = {
  superset:     { componentId: 'superset',     label: 'Apache Superset' },
  trino:        { componentId: 'trino',        label: 'Trino' },
  airflow:      { componentId: 'airflow',      label: 'Apache Airflow' },
  nifi:         { componentId: 'nifi',         label: 'Apache NiFi' },
  openmetadata: { componentId: 'openmetadata', label: 'OpenMetadata' },
  prometheus:   { componentId: 'prometheus',   label: 'Prometheus' },
  keycloak:     { componentId: 'keycloak',     label: 'Keycloak', path: '/realms/odap/account' },
  opensearch:   { componentId: 'opensearch',   label: 'OpenSearch Dashboards', path: '/app/data-explorer/discover' },
};

export async function getStaticPaths() {
  return Object.keys({
    superset: 0, trino: 0, airflow: 0, nifi: 0, openmetadata: 0,
    prometheus: 0, keycloak: 0, opensearch: 0,
  }).map((service) => ({ params: { service } }));
}

const { service } = Astro.params as { service: string };
const target = targets[service];
if (!target) return Astro.redirect('/');

const comp = components.find((c) => c.id === target.componentId);
const useEmbed = comp != null && isEmbeddable(comp);

// Voor embeddable: portal-interne /embed/<id>/ — same-origin, behoudt
// onze top-bar. Voor niet-embeddable (Keycloak admin etc): direct
// extern; client-script onder rewrite't .local → cloud TLD.
const url = useEmbed
  ? (target.path
    ? `/embed/${target.componentId}/?path=${encodeURIComponent(target.path)}`
    : `/embed/${target.componentId}/`)
  : `https://${target.componentId === 'keycloak' ? 'keycloak' : target.componentId}.odap.local:8443${target.path ?? ''}`;
---
<ShellLayout title={`${target.label} — SSO redirect`}>
  <section class="panel">
    <h1>Doorsturen naar {target.label}…</h1>
    <p id="status">Bezig met laden…</p>
    <p id="fallback" hidden>
      Automatisch doorsturen mislukte. Open
      <a href={url} rel="noreferrer">{target.label}</a> direct.
    </p>
  </section>

  <script define:vars={{ url }}>
    // Externe URLs worden door ShellLayout's embed-rewrite + TLD-rewrite
    // al naar /embed/<id>/ resp. cloud-TLD herleid; we doen hier de
    // window.location.replace zelf, want anchors-rewrite gebeurt pas na
    // DOMContentLoaded.
    function go() {
      const host = window.location.hostname;
      let dest = url;
      // Voor niet-embed URLs: TLD-rewrite spiegelen (de inline rewrite
      // werkt op anchors, niet op deze JS-variabele).
      if (/^https?:/.test(url)) {
        if (host.endsWith('.example.com')) {
          dest = url.replace(/odap-platform\.local(:8443)?/g, 'example.com');
        } else if (host.endsWith('.example.com')) {
          dest = url.replace(/odap-platform\.local(:8443)?/g, 'example.com');
        }
      }
      window.location.replace(dest);
    }
    setTimeout(() => {
      const fb = document.getElementById('fallback');
      if (fb) fb.hidden = false;
    }, 2000);
    go();
  </script>
</ShellLayout>
