---
// /go/minio/ — MINIMALE iframe-bootstrap voor MinIO Console SSO.
//
// Word geiframed door /embed/minio/ (zie components.ts
// `embed: { mode: 'subdomain', iframeBase: '/go/minio/' }`). De pagina
// fetcht via portal-nginx z'n in-cluster proxy (/api/minio-sso/login)
// het Keycloak-redirect-URL en `window.location.replace`'t direct
// — iframe gaat naar Keycloak SSO → terug naar minio-console →
// gebruiker landt on the MinIO Console UI, ingelogd.
//
// Waarom in-cluster proxy ipv directe call op
// https://minio-console.odap.local:8443/api/v1/login?
// Die endpoint returnt about the EXTERNE ingress `redirectRules: null`
// (MinIO Console-quirk; SSO-knop alleen via de in-cluster Service).
// portal/nginx.conf locatie `/api/minio-sso/login` proxyt naar
// minio-console.odap-platform.svc.cluster.local:9001/api/v1/login.
//
// BEWUST geen layout — een nested portal-topbar binnen de embed-shell
// iframe zou verwarrend zijn. We renderen alleen een tiny spinner
// totdat de redirect plaatsvindt (typisch < 100 ms).
---
<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <title>MinIO Console — SSO</title>
    <style>
      html, body { height: 100%; margin: 0; padding: 0; }
      body {
        background: #14130E;
        color: #C7C4B5;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        font-size: 14px;
      }
      .spinner {
        width: 14px; height: 14px;
        border: 2px solid #5E5A4D;
        border-top-color: #f59e0b;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      .fallback {
        display: none;
        text-align: center;
        max-width: 360px;
        line-height: 1.5;
      }
      .fallback.show { display: block; }
      .fallback a { color: #f59e0b; }
    </style>
  </head>
  <body>
    <div id="loading"><span class="spinner" aria-hidden="true"></span><span>MinIO openen via Keycloak…</span></div>
    <div id="fallback" class="fallback">
      SSO niet beschikbaar. Open
      <a href="https://minio-console.odap.local:8443" rel="noreferrer">MinIO Console</a>
      direct (root-account: <code>platformadmin</code>).
    </div>
    <script>
      (async function () {
        try {
          const r = await fetch('/api/minio-sso/login', { credentials: 'include' });
          if (!r.ok) throw new Error('login API ' + r.status);
          const j = await r.json();
          const url = j?.redirectRules?.[0]?.redirect;
          if (typeof url !== 'string' || !url.startsWith('https://')) {
            throw new Error('geen redirect-URL — heeft MinIO OIDC discovery gedaan?');
          }
          window.location.replace(url);
        } catch {
          // SSO redirect mislukt — toon de fallback met handmatige login-link.
          const fb = document.getElementById('fallback');
          const ld = document.getElementById('loading');
          if (fb) fb.className = 'fallback show';
          if (ld) ld.style.display = 'none';
        }
      })();
    </script>
  </body>
</html>
